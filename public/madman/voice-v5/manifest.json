      "rate": 0.92,
      "format": "wav",
      "sampleRate": 24000,
      "channels": 1,
      "codec": "pcm_s16le",
      "bitsPerSample": 16,
      "durationSeconds": 5.378167,
      "sha256": "0ba0a6e79bd78b0873d1869773d07eed2cb1796d3bcf34cc885ae4121f4c3a75",
      "origin": "v2-cache-copy",
      "reusedFromId": "history-2",
