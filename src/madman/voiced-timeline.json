          "audioDurationFrames": 69
        },
        {
          "from": 160,
          "duration": 128,
          "text": "今天才明白，我也在其中混了多年；",
          "audioFile": "public/madman/voice-v2/complicity-2.wav",
          "audioDurationSeconds": 4.453791666666667,
