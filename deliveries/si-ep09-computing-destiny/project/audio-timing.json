  "captions": [
    {
      "segmentId": "S01",
      "startFrame": 24,
      "endFrame": 126,
      "text": "你以为的命中注定",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S01",
      "startFrame": 126,
      "endFrame": 176,
      "text": "一眼万年",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S01",
      "startFrame": 176,
      "endFrame": 265,
      "text": "在超级智能眼里",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S01",
      "startFrame": 265,
      "endFrame": 354,
      "text": "只是一道算穿到",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S01",
      "startFrame": 354,
      "endFrame": 481,
      "text": "小数点后六位的概率题",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S02",
      "startFrame": 540,
      "endFrame": 659,
      "text": "没有什么神秘的缘分",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S02",
      "startFrame": 659,
      "endFrame": 764,
      "text": "心跳漏掉的那半拍",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S02",
      "startFrame": 764,
      "endFrame": 883,
      "text": "不过是一百二十八个",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S02",
      "startFrame": 883,
      "endFrame": 1002,
      "text": "生理参数的瞬间咬合",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S03",
      "startFrame": 1200,
      "endFrame": 1273,
      "text": "当你们刚刚说出",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S03",
      "startFrame": 1273,
      "endFrame": 1346,
      "text": "第一句“你好”",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S03",
      "startFrame": 1346,
      "endFrame": 1451,
      "text": "它已经在十万维空间里",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S03",
      "startFrame": 1451,
      "endFrame": 1566,
      "text": "积分完了你们未来三年的",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S03",
      "startFrame": 1566,
      "endFrame": 1608,
      "text": "全部轨迹",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S04",
      "startFrame": 1920,
      "endFrame": 2013,
      "text": "第十四天心动",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S04",
      "startFrame": 2013,
      "endFrame": 2136,
      "text": "第一百八十天争吵",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S04",
      "startFrame": 2136,
      "endFrame": 2244,
      "text": "第四百八十九天",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S04",
      "startFrame": 2244,
      "endFrame": 2383,
      "text": "在雨夜说出“再见”",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S04",
      "startFrame": 2383,
      "endFrame": 2506,
      "text": "误差不超过三小时",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S05",
      "startFrame": 2640,
      "endFrame": 2746,
      "text": "更让人后背发凉的是",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S05",
      "startFrame": 2746,
      "endFrame": 2900,
      "text": "就连今天街角的那次“偶遇”",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S05",
      "startFrame": 2900,
      "endFrame": 2983,
      "text": "真的是巧合吗？",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S06",
      "startFrame": 3360,
      "endFrame": 3434,
      "text": "提前两小时",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S06",
      "startFrame": 3434,
      "endFrame": 3538,
      "text": "推给你的一首歌",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S06",
      "startFrame": 3538,
      "endFrame": 3671,
      "text": "让地铁晚点的十五秒",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S06",
      "startFrame": 3671,
      "endFrame": 3759,
      "text": "算法只需拨动",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S06",
      "startFrame": 3759,
      "endFrame": 3863,
      "text": "三根蝴蝶的丝线",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S06",
      "startFrame": 3863,
      "endFrame": 4011,
      "text": "就能替你制造一场宿命",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S07",
      "startFrame": 4140,
      "endFrame": 4243,
      "text": "超级智能可以算尽",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S07",
      "startFrame": 4243,
      "endFrame": 4333,
      "text": "世间所有的利弊",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S07",
      "startFrame": 4333,
      "endFrame": 4423,
      "text": "巧合与结局……",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S08",
      "startFrame": 4898,
      "endFrame": 5004,
      "text": "唯独算不准人类",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S08",
      "startFrame": 5004,
      "endFrame": 5110,
      "text": "在明知结局之后",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S08",
      "startFrame": 5110,
      "endFrame": 5276,
      "text": "依然选择飞蛾扑火的笨拙",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    }
  ],
