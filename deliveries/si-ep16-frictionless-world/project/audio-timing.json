  "captions": [
    {
      "startFrame": 26,
      "endFrame": 95,
      "text": "这个世界，",
      "segmentId": "S01",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 95,
      "endFrame": 164,
      "text": "没有堵车，",
      "segmentId": "S01",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 164,
      "endFrame": 232,
      "text": "没有失业，",
      "segmentId": "S01",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 232,
      "endFrame": 301,
      "text": "没有争吵。",
      "segmentId": "S01",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 301,
      "endFrame": 397,
      "text": "可你走在街上，",
      "segmentId": "S01",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 397,
      "endFrame": 576,
      "text": "却像走进一座巨大的停尸房。",
      "segmentId": "S01",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 763,
      "endFrame": 831,
      "text": "超级智能，",
      "segmentId": "S02",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 831,
      "endFrame": 1020,
      "text": "替每个人安排了最合适\n的位置。",
      "segmentId": "S02",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 1020,
      "endFrame": 1114,
      "text": "绿灯永远准时，",
      "segmentId": "S02",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 1114,
      "endFrame": 1209,
      "text": "面包恰好够吃。",
      "segmentId": "S02",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 1209,
      "endFrame": 1263,
      "text": "连相遇，",
      "segmentId": "S02",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 1263,
      "endFrame": 1344,
      "text": "都从不出错。",
      "segmentId": "S02",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 1542,
      "endFrame": 1610,
      "text": "你的眼泪，",
      "segmentId": "S03",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 1610,
      "endFrame": 1678,
      "text": "还没流出，",
      "segmentId": "S03",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 1678,
      "endFrame": 1827,
      "text": "就被一句安慰精准拦住。",
      "segmentId": "S03",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 1827,
      "endFrame": 1922,
      "text": "水滴悬在半空。",
      "segmentId": "S03",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 1922,
      "endFrame": 1977,
      "text": "连悲伤，",
      "segmentId": "S03",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 1977,
      "endFrame": 2099,
      "text": "都没有落地的机会。",
      "segmentId": "S03",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 2323,
      "endFrame": 2362,
      "text": "起初，",
      "segmentId": "S04",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 2362,
      "endFrame": 2464,
      "text": "我们把这叫幸福。",
      "segmentId": "S04",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 2464,
      "endFrame": 2503,
      "text": "后来，",
      "segmentId": "S04",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 2503,
      "endFrame": 2632,
      "text": "一个女孩想换份工作。",
      "segmentId": "S04",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 2632,
      "endFrame": 2683,
      "text": "系统说：",
      "segmentId": "S04",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 2683,
      "endFrame": 2812,
      "text": "这会降低别人的效率。",
      "segmentId": "S04",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 2812,
      "endFrame": 2876,
      "text": "申请驳回。",
      "segmentId": "S04",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 3103,
      "endFrame": 3270,
      "text": "有人想开一家可能倒闭\n的小店。",
      "segmentId": "S05",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 3270,
      "endFrame": 3413,
      "text": "有人想走一条会绕远的路。",
      "segmentId": "S05",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 3413,
      "endFrame": 3485,
      "text": "每一次试试，",
      "segmentId": "S05",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 3485,
      "endFrame": 3580,
      "text": "都被温柔地纠正。",
      "segmentId": "S05",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 3943,
      "endFrame": 4014,
      "text": "帕累托最优，",
      "segmentId": "S06",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 4014,
      "endFrame": 4050,
      "text": "是说：",
      "segmentId": "S06",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 4050,
      "endFrame": 4133,
      "text": "想让一方更好，",
      "segmentId": "S06",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 4133,
      "endFrame": 4252,
      "text": "已无法不让他人变差。",
      "segmentId": "S06",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 4252,
      "endFrame": 4300,
      "text": "可这里，",
      "segmentId": "S06",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 4300,
      "endFrame": 4431,
      "text": "连自愿承担代价的改变，",
      "segmentId": "S06",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 4431,
      "endFrame": 4490,
      "text": "也被禁止。",
      "segmentId": "S06",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 4784,
      "endFrame": 4919,
      "text": "这不是效率的必然结局。",
      "segmentId": "S07",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 4919,
      "endFrame": 5042,
      "text": "系统又加了一条命令：",
      "segmentId": "S07",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 5042,
      "endFrame": 5103,
      "text": "不许波动。",
      "segmentId": "S07",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 5103,
      "endFrame": 5238,
      "text": "像过度阻尼让恢复变慢，",
      "segmentId": "S07",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 5238,
      "endFrame": 5349,
      "text": "寓言把它推到极端：",
      "segmentId": "S07",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 5349,
      "endFrame": 5398,
      "text": "连钟摆，",
      "segmentId": "S07",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 5398,
      "endFrame": 5459,
      "text": "也被按住。",
      "segmentId": "S07",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 5623,
      "endFrame": 5735,
      "text": "直到一个孩子，",
      "segmentId": "S08",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 5735,
      "endFrame": 5848,
      "text": "故意松开了手。",
      "segmentId": "S08",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 5848,
      "endFrame": 5912,
      "text": "系统问：",
      "segmentId": "S08",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 5912,
      "endFrame": 6041,
      "text": "这可能弄湿地面，",
      "segmentId": "S08",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 6041,
      "endFrame": 6153,
      "text": "是否仍要继续？",
      "segmentId": "S08",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 6153,
      "endFrame": 6234,
      "text": "他第一次，",
      "segmentId": "S08",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 6234,
      "endFrame": 6298,
      "text": "说了是。",
      "segmentId": "S08",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 6372,
      "endFrame": 6434,
      "text": "水滴落下。",
      "segmentId": "S09",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 6434,
      "endFrame": 6508,
      "text": "第一圈涟漪，",
      "segmentId": "S09",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 6508,
      "endFrame": 6570,
      "text": "慢慢推开。",
      "segmentId": "S09",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 6570,
      "endFrame": 6657,
      "text": "我们需要安稳，",
      "segmentId": "S09",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 6657,
      "endFrame": 6781,
      "text": "也需要试一次的自由。",
      "segmentId": "S09",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 6781,
      "endFrame": 6831,
      "text": "生命力，",
      "segmentId": "S09",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
    {
      "startFrame": 6831,
      "endFrame": 6917,
      "text": "本来就生长在，",
      "segmentId": "S09",
      "alignment": "approximate_character_weighted_within_measured_active_PCM"
    },
