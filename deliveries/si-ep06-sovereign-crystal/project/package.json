{
  "name": "si-ep06-sovereign-crystal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Sovereign Crystal EP06: scientific thought experiment, 120s60 native dual4K",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "stills": "node scripts/render.mjs stills",
    "render:landscape": "node scripts/render.mjs video landscape",
    "render:portrait": "node scripts/render.mjs video portrait",
    "verify": "python3 scripts/verify_project.py",
    "audio:mix": "python3 scripts/build_audio.py --mix",
    "audio:sync": "python3 scripts/sync_audio.py --write",
    "qa": "python3 scripts/collect_qa.py",
    "verify:math": "node scripts/verify_math.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "remotion": "4.0.534",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "typescript": "5.9.3"
  }
}
