  "captions": [
    {
      "segmentId": "S01",
      "startFrame": 120,
      "endFrame": 237,
      "text": "人类引以为傲的工业文明",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S01",
      "startFrame": 237,
      "endFrame": 342,
      "text": "其实是一场长达千年的",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S01",
      "startFrame": 342,
      "endFrame": 406,
      "text": "“直线崇拜”",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S02",
      "startFrame": 660,
      "endFrame": 753,
      "text": "横平竖直的方格子",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S02",
      "startFrame": 753,
      "endFrame": 846,
      "text": "对称的齿轮与钢梁",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S02",
      "startFrame": 846,
      "endFrame": 963,
      "text": "不过是因为人类的大脑",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S02",
      "startFrame": 963,
      "endFrame": 1056,
      "text": "算不出复杂的应力",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S03",
      "startFrame": 1320,
      "endFrame": 1384,
      "text": "当超级智能",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S03",
      "startFrame": 1384,
      "endFrame": 1498,
      "text": "接手物质的底层设计",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S03",
      "startFrame": 1498,
      "endFrame": 1613,
      "text": "它用一亿次流体模拟",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S03",
      "startFrame": 1613,
      "endFrame": 1753,
      "text": "无情地扯下了这层遮羞布",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S04",
      "startFrame": 1860,
      "endFrame": 1919,
      "text": "在它眼里",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S04",
      "startFrame": 1919,
      "endFrame": 2052,
      "text": "直线是最奢侈的浪费",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S04",
      "startFrame": 2052,
      "endFrame": 2170,
      "text": "对称是无能的妥协",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S04",
      "startFrame": 2170,
      "endFrame": 2244,
      "text": "真正的完美",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S04",
      "startFrame": 2244,
      "endFrame": 2363,
      "text": "长得像深海的硅藻",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S04",
      "startFrame": 2363,
      "endFrame": 2466,
      "text": "与昆虫的外骨骼",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S05",
      "startFrame": 2580,
      "endFrame": 2655,
      "text": "伴随着一亿次",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S05",
      "startFrame": 2655,
      "endFrame": 2780,
      "text": "有限元分析的疯狂迭代",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S05",
      "startFrame": 2780,
      "endFrame": 2893,
      "text": "原本笨重的金属支架",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S05",
      "startFrame": 2893,
      "endFrame": 3018,
      "text": "开始像有生命一样融化",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S05",
      "startFrame": 3018,
      "endFrame": 3068,
      "text": "长出孔洞",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S06",
      "startFrame": 3600,
      "endFrame": 3719,
      "text": "没有一处多余的原子",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S06",
      "startFrame": 3719,
      "endFrame": 3837,
      "text": "没有一根无用的线条",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S06",
      "startFrame": 3837,
      "endFrame": 3916,
      "text": "它变成了一件",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S06",
      "startFrame": 3916,
      "endFrame": 4035,
      "text": "轻十倍、却强百倍的",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S06",
      "startFrame": 4035,
      "endFrame": 4114,
      "text": "绝美外星造物",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S07",
      "startFrame": 4440,
      "endFrame": 4536,
      "text": "当人类的对称美学",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S07",
      "startFrame": 4536,
      "endFrame": 4631,
      "text": "在绝对的效率面前",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S07",
      "startFrame": 4631,
      "endFrame": 4691,
      "text": "被碾得粉碎",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S07",
      "startFrame": 4691,
      "endFrame": 4775,
      "text": "我们才突然惊觉",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S07",
      "startFrame": 4775,
      "endFrame": 4918,
      "text": "大自然才是最高级的程序员",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S08",
      "startFrame": 5400,
      "endFrame": 5470,
      "text": "当神明开始",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S08",
      "startFrame": 5470,
      "endFrame": 5596,
      "text": "重塑物理世界的骨骼",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S08",
      "startFrame": 5596,
      "endFrame": 5723,
      "text": "人类建构的钢铁森林",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S08",
      "startFrame": 5723,
      "endFrame": 5849,
      "text": "瞬间成了过时的积木",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S09",
      "startFrame": 6300,
      "endFrame": 6428,
      "text": "下一次观测：零秒华尔街",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S10",
      "startFrame": 6600,
      "endFrame": 6741,
      "text": "片中数字为科幻设定",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S10",
      "startFrame": 6741,
      "endFrame": 6867,
      "text": "真实优化仍受载荷",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S10",
      "startFrame": 6867,
      "endFrame": 6977,
      "text": "材料与制造约束",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    }
  ],
