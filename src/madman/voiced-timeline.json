      "asset": "typeset",
      "cues": [
        {
          "from": 20,
          "duration": 146,
          "text": "我翻开历史一查，这历史没有年代，",
          "audioFile": "public/madman/voice-v2/history-1.wav",
          "audioDurationSeconds": 4.201666666666667,
          "audioStartFrame": 716,
          "audioDurationFrames": 101
        },
        {
          "from": 174,
          "duration": 138,
          "text": "歪歪斜斜的每叶上都写着“仁义道德”几个字。",
          "audioFile": "public/madman/voice-v2/history-2.wav",
          "audioDurationSeconds": 5.378166666666667,
          "audioStartFrame": 870,
          "audioDurationFrames": 130
        },
        {
          "from": 320,
          "duration": 126,
          "text": "满本都写着两个字是“吃人”！",
          "audioFile": "public/madman/voice-v2/history-3.wav",
          "audioDurationSeconds": 3.0252083333333335,
          "audioStartFrame": 1016,
          "audioDurationFrames": 73
        }
