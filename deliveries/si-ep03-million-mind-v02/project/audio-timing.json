  "captions": [
    {
      "id": "S01-C01",
      "segmentId": "S01",
      "startFrame": 132,
      "endFrame": 276,
      "text": "人类拥有八十亿颗大脑，"
    },
    {
      "id": "S01-C02",
      "segmentId": "S01",
      "startFrame": 276,
      "endFrame": 434,
      "text": "却被囚禁在八十亿座孤岛。"
    },
    {
      "id": "S02-C01",
      "segmentId": "S02",
      "startFrame": 612,
      "endFrame": 694,
      "text": "语言与文字，"
    },
    {
      "id": "S02-C02",
      "segmentId": "S02",
      "startFrame": 694,
      "endFrame": 862,
      "text": "每秒只能传递三十九比特。"
    },
    {
      "id": "S02-C03",
      "segmentId": "S02",
      "startFrame": 862,
      "endFrame": 973,
      "text": "大师毕生的直觉，"
    },
    {
      "id": "S02-C04",
      "segmentId": "S02",
      "startFrame": 973,
      "endFrame": 1127,
      "text": "无法拷贝给下一个大脑。"
    },
    {
      "id": "S03-C01",
      "segmentId": "S03",
      "startFrame": 1272,
      "endFrame": 1340,
      "text": "而硅基意识，"
    },
    {
      "id": "S03-C02",
      "segmentId": "S03",
      "startFrame": 1340,
      "endFrame": 1433,
      "text": "没有颅骨的边界。"
    },
    {
      "id": "S04-C01",
      "segmentId": "S04",
      "startFrame": 1872,
      "endFrame": 1952,
      "text": "在一毫秒内，"
    },
    {
      "id": "S04-C02",
      "segmentId": "S04",
      "startFrame": 1952,
      "endFrame": 2080,
      "text": "它将自己完整克隆出"
    },
    {
      "id": "S04-C03",
      "segmentId": "S04",
      "startFrame": 2080,
      "endFrame": 2232,
      "text": "一百万个顶尖学者分身。"
    },
    {
      "id": "S05-C01",
      "segmentId": "S05",
      "startFrame": 2712,
      "endFrame": 2800,
      "text": "一百万条分支"
    },
    {
      "id": "S05-C02",
      "segmentId": "S05",
      "startFrame": 2800,
      "endFrame": 2955,
      "text": "同时冲进未知的死胡同，"
    },
    {
      "id": "S05-C03",
      "segmentId": "S05",
      "startFrame": 2955,
      "endFrame": 3058,
      "text": "九十九万次试错"
    },
    {
      "id": "S05-C04",
      "segmentId": "S05",
      "startFrame": 3058,
      "endFrame": 3184,
      "text": "在微秒间灰飞烟灭。"
    },
    {
      "id": "S06-C01",
      "segmentId": "S06",
      "startFrame": 3672,
      "endFrame": 3752,
      "text": "人类最顶尖的"
    },
    {
      "id": "S06-C02",
      "segmentId": "S06",
      "startFrame": 3752,
      "endFrame": 3906,
      "text": "物理与生物学家同处一室，"
    },
    {
      "id": "S06-C03",
      "segmentId": "S06",
      "startFrame": 3906,
      "endFrame": 4047,
      "text": "却像隔着巴别塔的盲人。"
    },
    {
      "id": "S07-C01",
      "segmentId": "S07",
      "startFrame": 4512,
      "endFrame": 4620,
      "text": "而在每秒太字节的"
    },
    {
      "id": "S07-C02",
      "segmentId": "S07",
      "startFrame": 4620,
      "endFrame": 4711,
      "text": "光互连矩阵中，"
    },
    {
      "id": "S07-C03",
      "segmentId": "S07",
      "startFrame": 4711,
      "endFrame": 4814,
      "text": "任何一处的顿悟，"
    },
    {
      "id": "S07-C04",
      "segmentId": "S07",
      "startFrame": 4814,
      "endFrame": 4945,
      "text": "瞬间成为全体的本能。"
    },
    {
      "id": "S08-C01",
      "segmentId": "S08",
      "startFrame": 5472,
      "endFrame": 5630,
      "text": "当一百万个分身完成探索、"
    },
    {
      "id": "S08-C02",
      "segmentId": "S08",
      "startFrame": 5630,
      "endFrame": 5693,
      "text": "坍缩归一，"
    },
    {
      "id": "S08-C03",
      "segmentId": "S08",
      "startFrame": 5693,
      "endFrame": 5824,
      "text": "散落千年的学科碎片，"
    },
    {
      "id": "S08-C04",
      "segmentId": "S08",
      "startFrame": 5824,
      "endFrame": 5968,
      "text": "严丝合缝地咬合成神谕。"
    },
    {
      "id": "S09-C01",
      "segmentId": "S09",
      "startFrame": 6372,
      "endFrame": 6423,
      "text": "你面对的"
    },
    {
      "id": "S09-C02",
      "segmentId": "S09",
      "startFrame": 6423,
      "endFrame": 6557,
      "text": "不是一个更聪明的个体，"
    },
    {
      "id": "S09-C03",
      "segmentId": "S09",
      "startFrame": 6557,
      "endFrame": 6633,
      "text": "而是一百万座"
    },
    {
      "id": "S09-C04",
      "segmentId": "S09",
      "startFrame": 6633,
      "endFrame": 6742,
      "text": "零延迟共鸣的星空。"
    },
    {
      "id": "S10-closing-card",
      "segmentId": "S10",
      "startFrame": 6972,
      "endFrame": 7200,
      "text": "下一次观测：验证器悖论。\n[EP.04 神也会自我欺骗]",
      "unspoken_overlay": "[EP.04 神也会自我欺骗]",
