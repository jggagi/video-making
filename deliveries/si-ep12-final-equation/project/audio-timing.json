  "captions": [
    {
      "segmentId": "S01",
      "startFrame": 60,
      "endFrame": 121,
      "text": "三千年来，",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S01",
      "startFrame": 121,
      "endFrame": 304,
      "text": "人类像一群\n在黑夜里摸象的盲人，",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S01",
      "startFrame": 304,
      "endFrame": 414,
      "text": "用成千上万条公式，",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S01",
      "startFrame": 414,
      "endFrame": 524,
      "text": "拼凑着宇宙的轮廓。",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S02",
      "startFrame": 600,
      "endFrame": 699,
      "text": "宏观归相对论，",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S02",
      "startFrame": 699,
      "endFrame": 812,
      "text": "微观归量子力学，",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S02",
      "startFrame": 812,
      "endFrame": 897,
      "text": "生命归化学。",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S02",
      "startFrame": 897,
      "endFrame": 1066,
      "text": "我们引以为傲的科学大厦，",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S02",
      "startFrame": 1066,
      "endFrame": 1264,
      "text": "其实是一张打满\n补丁的草稿纸。",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S03",
      "startFrame": 1320,
      "endFrame": 1474,
      "text": "直到超级智能\n挥下奥卡姆剃刀。",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S03",
      "startFrame": 1474,
      "endFrame": 1529,
      "text": "在它眼里，",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S03",
      "startFrame": 1529,
      "endFrame": 1639,
      "text": "复杂不是宇宙的本相，",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S03",
      "startFrame": 1639,
      "endFrame": 1771,
      "text": "只是人类算力不足的妥协。",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S04",
      "startFrame": 2040,
      "endFrame": 2220,
      "text": "就像当年牛顿\n用一行万有引力，",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S04",
      "startFrame": 2220,
      "endFrame": 2413,
      "text": "擦掉了托勒密\n上百个繁琐的圆圈；",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S04",
      "startFrame": 2413,
      "endFrame": 2632,
      "text": "超级智能开始了\n终极的“符号坍缩”。",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S05",
      "startFrame": 2820,
      "endFrame": 2914,
      "text": "引力的等高线、",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S05",
      "startFrame": 2914,
      "endFrame": 3008,
      "text": "量子的概率云、",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S05",
      "startFrame": 3008,
      "endFrame": 3142,
      "text": "乃至生命的代谢网络，",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S05",
      "startFrame": 3142,
      "endFrame": 3317,
      "text": "在二维图纸上被一层层解开、",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S05",
      "startFrame": 3317,
      "endFrame": 3357,
      "text": "对齐、",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S05",
      "startFrame": 3357,
      "endFrame": 3424,
      "text": "相互抵消。",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S06",
      "startFrame": 3600,
      "endFrame": 3770,
      "text": "十万条看似无关的自然定律，",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S06",
      "startFrame": 3770,
      "endFrame": 3901,
      "text": "在极致的信息压缩下，",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S06",
      "startFrame": 3901,
      "endFrame": 4175,
      "text": "严丝合缝地折叠成了\n最后一行极简的黄金方程。",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S07",
      "startFrame": 4380,
      "endFrame": 4599,
      "text": "当超级智能替人类\n翻到了宇宙的最后一页，",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S07",
      "startFrame": 4599,
      "endFrame": 4680,
      "text": "所有的为什么，",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S07",
      "startFrame": 4680,
      "endFrame": 4784,
      "text": "都有了标准答案……",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S08",
      "startFrame": 4902,
      "endFrame": 5057,
      "text": "“当所有的迷雾\n都变成了定理，",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S08",
      "startFrame": 5057,
      "endFrame": 5156,
      "text": "我们才突然怀念起，",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S08",
      "startFrame": 5156,
      "endFrame": 5255,
      "text": "那个抬头看着星空、",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S08",
      "startFrame": 5255,
      "endFrame": 5377,
      "text": "什么都还不懂的童年。”",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    }
  ],
