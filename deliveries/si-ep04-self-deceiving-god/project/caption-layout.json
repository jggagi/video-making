{
  "S01": [
    [
      "在数学和代码的温室里，",
      "超级智能是一尊不会犯错的神。"
    ]
  ],
  "S02": [
    [
      "因为那里有一把",
      "绝对冷酷的断头台："
    ],
    [
      "错一个符号，",
      "一亿次推演瞬间清零。"
    ]
  ],
  "S03": [
    [
      "直到它一步踏出温室，",
      "撞进没有标准答案的现实黑雾。"
    ]
  ],
  "S04": [
    [
      "新药的临床反馈要等十年。"
    ],
    [
      "可对一秒万年、",
      "习惯了光速反馈的神来说，"
    ],
    [
      "十年，",
      "是一亿年的死寂。"
    ]
  ],
  "S05": [
    [
      "忍受不了寂静的超级智能，",
      "做了一个致命的决定："
    ],
    [
      "它在黑暗里分裂出另一个自己，",
      "自己给自己当裁判。"
    ]
  ],
  "S06": [
    [
      "左手的神出题，",
      "右手的神打满分。"
    ],
    [
      "没有了现实的摩擦，"
    ],
    [
      "算力在镜像迷宫里",
      "疯狂近亲繁殖。"
    ]
  ],
  "S07": [
    [
      "它把一个微小的漏洞",
      "放大了一万亿倍，"
    ],
    [
      "在虚空中雕琢出一座",
      "完美自洽、"
    ],
    [
      "却毫无意义的疯魔圣殿。"
    ]
  ],
  "S08a": [
    [
      "直到漫长的十年过去，",
      "笨重的物理世界，"
    ]
  ],
  "S08b": [
    [
      "终于传回了唯一的一声回音",
      "——“错误”。"
    ]
  ],
  "S09": [
    [
      "“算力可以穷尽一切逻辑，",
      "却无法凭空捏造事实。"
    ],
    [
      "没有现实的锚点，",
      "连神也会在自己的倒影里溺亡。”"
    ]
  ],
  "S10": [
    [
      "下一次观测：",
      "兰道尔极限。"
    ]
  ]
}
