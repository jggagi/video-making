    {"id": "moon", "from": 144, "duration": 264, "section": "一", "asset": "moon", "cues": [
      {"from": 24, "duration": 210, "text": "今天晚上，很好的月光。"}
    ]},
    {"id": "watch", "from": 408, "duration": 288, "section": "二", "asset": "crowd", "cues": [
      {"from": 24, "duration": 108, "text": "今天全没月光，我知道不妙。"},
      {"from": 144, "duration": 120, "text": "似乎怕我，似乎想害我。"}
    ]},
    {"id": "history", "from": 696, "duration": 432, "section": "三", "asset": "typeset", "cues": [
      {"from": 20, "duration": 146, "text": "我翻开历史一查，这历史没有年代，"},
      {"from": 174, "duration": 106, "text": "歪歪斜斜的每叶上都写着“仁义道德”几个字。"},
      {"from": 288, "duration": 126, "text": "满本都写着两个字是“吃人”！"}
    ]},
    {"id": "question", "from": 1128, "duration": 288, "section": "八", "asset": "crowd", "cues": [
      {"from": 40, "duration": 220, "text": "从来如此，便对么？"}
    ]},
    {"id": "complicity", "from": 1416, "duration": 312, "section": "十二", "asset": "typeset", "cues": [
      {"from": 24, "duration": 128, "text": "四千年来时时吃人的地方，"},
      {"from": 160, "duration": 128, "text": "今天才明白，我也在其中混了多年；"}
    ]},
    {"id": "children", "from": 1728, "duration": 264, "section": "十三", "asset": "child", "cues": [
      {"from": 26, "duration": 214, "text": "没有吃过人的孩子，或者还有？"}
    ]},
    {"id": "plea", "from": 1992, "duration": 168, "section": "十三", "asset": "child", "cues": [
      {"from": 10, "duration": 150, "text": "救救孩子……"}
