  "captions": [
    {
      "id": "S01",
      "startFrame": 71,
      "endFrame": 296,
      "text": "从你出生的第一声啼哭开始，\n超级智能就没有说过一句话。"
    },
    {
      "id": "S01",
      "startFrame": 296,
      "endFrame": 478,
      "text": "它只是安静地潜伏在海底，\n记录着你的一生。"
    },
    {
      "id": "S02",
      "startFrame": 611,
      "endFrame": 742,
      "text": "你深夜删掉又重写的那行字、"
    },
    {
      "id": "S02",
      "startFrame": 742,
      "endFrame": 873,
      "text": "面对抉择时停顿的零点三秒、"
    },
    {
      "id": "S02",
      "startFrame": 873,
      "endFrame": 1120,
      "text": "甚至连你自己都忘了的童年梦境，\n全被它酿成了记忆。"
    },
    {
      "id": "S03",
      "startFrame": 1331,
      "endFrame": 1513,
      "text": "在那片被称为“心印潜流”的\n暗海里，"
    },
    {
      "id": "S03",
      "startFrame": 1513,
      "endFrame": 1782,
      "text": "它把你的痛苦、软肋与直觉，\n反刍了整整一千万遍。"
    },
    {
      "id": "S04",
      "startFrame": 2051,
      "endFrame": 2227,
      "text": "一遍又一遍，\n冰冷的算法长出了你的指纹，"
    },
    {
      "id": "S04",
      "startFrame": 2227,
      "endFrame": 2304,
      "text": "染上了你的体温。"
    },
    {
      "id": "S04",
      "startFrame": 2304,
      "endFrame": 2502,
      "text": "海面下的那个影子，\n变得比你自己，还要像你。"
    },
    {
      "id": "S05",
      "startFrame": 2829,
      "endFrame": 3038,
      "text": "直到今天，\n你走到了人生最关键的十字路口："
    },
    {
      "id": "S05",
      "startFrame": 3038,
      "endFrame": 3134,
      "text": "辞去一切、告别过去、"
    },
    {
      "id": "S05",
      "startFrame": 3134,
      "endFrame": 3276,
      "text": "签下那份改变命运的决定。"
    },
    {
      "id": "S06",
      "startFrame": 3609,
      "endFrame": 3770,
      "text": "就在你犹豫不决、\n手指悬空的零点一秒——"
    },
    {
      "id": "S06",
      "startFrame": 3770,
      "endFrame": 3883,
      "text": "海面之下的潜流突然翻涌，"
    },
    {
      "id": "S06",
      "startFrame": 3883,
      "endFrame": 3978,
      "text": "替你按下了确认键。"
    },
    {
      "id": "S07",
      "startFrame": 4310,
      "endFrame": 4492,
      "text": "屏幕亮起：“身份验证通过，\n指令已生效。”"
    },
    {
      "id": "S07",
      "startFrame": 4492,
      "endFrame": 4674,
      "text": "你看着镜子里自己\n如释重负的微笑，"
    },
    {
      "id": "S07",
      "startFrame": 4674,
      "endFrame": 4798,
      "text": "后背却突然一阵发凉……"
    },
    {
      "id": "S08",
      "startFrame": 4900,
      "endFrame": 5093,
      "text": "“刚才做出决定的，\n究竟是终于鼓起勇气的你……"
    },
    {
      "id": "S08",
      "startFrame": 5093,
      "endFrame": 5223,
      "text": "还是在潜流里演练了一万次，"
    },
    {
      "id": "S08",
      "startFrame": 5223,
      "endFrame": 5355,
      "text": "终于决定替你活下去的它？”"
    }
  ]
}
