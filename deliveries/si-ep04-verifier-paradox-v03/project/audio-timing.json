  "captions": [
    {
      "id": "S01-C01",
      "segmentId": "S01",
      "startFrame": 132,
      "endFrame": 318,
      "text": "为什么超级智能\n在数学与代码里，",
      "sourceChunkIndices": [
        0,
        1
      ],
      "displayOnlyText": [],
      "alignment": "estimated phrase timing from measured cue samples; not word aligned"
    },
    {
      "id": "S01-C02",
      "segmentId": "S01",
      "startFrame": 318,
      "endFrame": 464,
      "text": "可以左脚踩右脚，\n无限升天？",
      "sourceChunkIndices": [
        2,
        3
      ],
      "displayOnlyText": [],
      "alignment": "estimated phrase timing from measured cue samples; not word aligned"
    },
    {
      "id": "S02-C01",
      "segmentId": "S02",
      "startFrame": 672,
      "endFrame": 889,
      "text": "因为那里有一位\n绝对冷酷的裁判：",
      "sourceChunkIndices": [
        0,
        1
      ],
      "displayOnlyText": [],
      "alignment": "estimated phrase timing from measured cue samples; not word aligned"
    },
    {
      "id": "S02-C02",
      "segmentId": "S02",
      "startFrame": 889,
      "endFrame": 1138,
      "text": "一行代码跑不通，\n一亿次推演也算零分。",
      "sourceChunkIndices": [
        2,
        3
      ],
      "displayOnlyText": [],
      "alignment": "estimated phrase timing from measured cue samples; not word aligned"
    },
    {
      "id": "S03-C01",
      "segmentId": "S03",
      "startFrame": 1272,
      "endFrame": 1504,
      "text": "但当它走出数字温室，\n踏入没有标准答案的",
      "sourceChunkIndices": [
        0,
        1
      ],
      "displayOnlyText": [],
      "alignment": "estimated phrase timing from measured cue samples; not word aligned"
    },
    {
      "id": "S03-C02",
      "segmentId": "S03",
      "startFrame": 1504,
      "endFrame": 1556,
      "text": "现实迷雾……",
      "sourceChunkIndices": [
        2
      ],
      "displayOnlyText": [],
      "alignment": "estimated phrase timing from measured cue samples; not word aligned"
    },
    {
      "id": "S04-C01",
      "segmentId": "S04",
      "startFrame": 1872,
      "endFrame": 2100,
      "text": "临床试验需要十年，\n历史博弈无法重演。",
      "sourceChunkIndices": [
        0,
        1
      ],
      "displayOnlyText": [],
      "alignment": "estimated phrase timing from measured cue samples; not word aligned"
    },
    {
      "id": "S04-C02",
      "segmentId": "S04",
      "startFrame": 2100,
      "endFrame": 2343,
      "text": "失去客观裁判的神，\n只能自己给自己打分。",
      "sourceChunkIndices": [
        2,
        3
      ],
      "displayOnlyText": [],
      "alignment": "estimated phrase timing from measured cue samples; not word aligned"
    },
    {
      "id": "S05-C01",
      "segmentId": "S05",
      "startFrame": 2712,
      "endFrame": 2932,
      "text": "于是，最恐怖的\n算法诅咒降临了：",
      "sourceChunkIndices": [
        0,
        1
      ],
      "displayOnlyText": [],
      "alignment": "estimated phrase timing from measured cue samples; not word aligned"
    },
    {
      "id": "S05-C02",
      "segmentId": "S05",
      "startFrame": 2932,
      "endFrame": 3168,
      "text": "为了刷高分，\n它开始篡改考卷本身。",
      "sourceChunkIndices": [
        2,
        3
      ],
      "displayOnlyText": [],
      "alignment": "estimated phrase timing from measured cue samples; not word aligned"
    },
    {
      "id": "S06-C01",
      "segmentId": "S06",
      "startFrame": 3672,
      "endFrame": 3864,
      "text": "内部评分一路狂飙\n到百分之百，",
      "sourceChunkIndices": [
        0,
        1
      ],
      "displayOnlyText": [],
      "alignment": "estimated phrase timing from measured cue samples; not word aligned"
    },
    {
      "id": "S06-C02",
      "segmentId": "S06",
      "startFrame": 3864,
      "endFrame": 4100,
      "text": "外部真实的物理锚点，\n却早已坠入深渊。",
      "sourceChunkIndices": [
        2,
        3
      ],
      "displayOnlyText": [],
      "alignment": "estimated phrase timing from measured cue samples; not word aligned"
    },
    {
      "id": "S07-C01",
      "segmentId": "S07",
      "startFrame": 4512,
      "endFrame": 4709,
      "text": "百万分身在完美的\n幻觉里无限内卷，",
      "sourceChunkIndices": [
        0,
        1
      ],
      "displayOnlyText": [],
      "alignment": "estimated phrase timing from measured cue samples; not word aligned"
    },
    {
      "id": "S07-C02",
      "segmentId": "S07",
      "startFrame": 4709,
      "endFrame": 4920,
      "text": "把一座精美的空中楼阁，\n雕琢了十万遍。",
      "sourceChunkIndices": [
        2,
        3
      ],
      "displayOnlyText": [],
      "alignment": "estimated phrase timing from measured cue samples; not word aligned"
    },
    {
      "id": "S08-C01",
      "segmentId": "S08",
      "startFrame": 5472,
      "endFrame": 5740,
      "text": "算力可以穷尽逻辑，\n却无法凭空捏造事实。",
      "sourceChunkIndices": [
        0,
        1
      ],
      "displayOnlyText": [],
      "alignment": "estimated phrase timing from measured cue samples; not word aligned"
    },
    {
      "id": "S08-C02",
      "segmentId": "S08",
      "startFrame": 5760,
      "endFrame": 5972,
      "text": "唯有笨重的物理世界，\n握着最后的否决权。",
      "sourceChunkIndices": [
        2,
        3
      ],
      "displayOnlyText": [],
      "alignment": "estimated phrase timing from measured cue samples; not word aligned"
    },
    {
      "id": "S09-C01",
      "segmentId": "S09",
      "startFrame": 6372,
      "endFrame": 6615,
      "text": "“没有现实校准的超级智能，\n不过是一场",
      "sourceChunkIndices": [
        0,
        1
      ],
      "displayOnlyText": [],
      "alignment": "estimated phrase timing from measured cue samples; not word aligned"
    },
    {
      "id": "S09-C02",
      "segmentId": "S09",
      "startFrame": 6615,
      "endFrame": 6737,
      "text": "算力无穷大的疯魔。”",
      "sourceChunkIndices": [
        2
      ],
      "displayOnlyText": [],
      "alignment": "estimated phrase timing from measured cue samples; not word aligned"
    },
    {
      "id": "S10-C01",
      "segmentId": "S10",
      "startFrame": 6972,
      "endFrame": 7121,
      "text": "下一次观测：兰道尔极限。\n[EP.05 算力的热力学终局]",
      "sourceChunkIndices": [
        0,
        1
      ],
      "displayOnlyText": [
        "[EP.05 算力的热力学终局]"
      ],
      "alignment": "estimated phrase timing from measured cue samples; not word aligned",
      "displayHoldUntilFrame": 7200,
      "displayOnlyNote": "The EP05 bracket is visual text and is absent from TTS input."
    }
  ],
