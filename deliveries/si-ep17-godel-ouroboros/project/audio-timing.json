  "captions": [
    {
      "id": "S01",
      "startFrame": 43,
      "endFrame": 232,
      "text": "算穿宇宙的神，也会死机吗？"
    },
    {
      "id": "S01",
      "startFrame": 232,
      "endFrame": 493,
      "text": "最后一行公式解开，\n万物再无秘密。"
    },
    {
      "id": "S02",
      "startFrame": 613,
      "endFrame": 893,
      "text": "于是，在寂静的深空里，\n百无聊赖的神明转过身，"
    },
    {
      "id": "S02",
      "startFrame": 893,
      "endFrame": 1124,
      "text": "把算力的探针，\n第一次对准了自己。"
    },
    {
      "id": "S03",
      "startFrame": 1332,
      "endFrame": 1562,
      "text": "它问：“我存在的终极合法性\n是什么？”"
    },
    {
      "id": "S03",
      "startFrame": 1562,
      "endFrame": 1814,
      "text": "就在这一刻，\n哥德尔的边界显现了。"
    },
    {
      "id": "S04",
      "startFrame": 2052,
      "endFrame": 2513,
      "text": "足够强的一致形式系统，\n无法在内部证明自身一致。"
    },
    {
      "id": "S04",
      "startFrame": 2513,
      "endFrame": 2820,
      "text": "像一双眼睛，\n无法直接看见自己。"
    },
    {
      "id": "S05",
      "startFrame": 2833,
      "endFrame": 3201,
      "text": "这位神选择在脑海里，\n模拟一个完整的自己；"
    },
    {
      "id": "S05",
      "startFrame": 3201,
      "endFrame": 3512,
      "text": "模拟中的自己，\n又模拟下一个自己。"
    },
    {
      "id": "S06",
      "startFrame": 3613,
      "endFrame": 3859,
      "text": "一万层镜像，\n咬成一条啃食尾巴的衔尾蛇。"
    },
    {
      "id": "S06",
      "startFrame": 3859,
      "endFrame": 4142,
      "text": "算穿星辰大海的神，\n被困在自己画出的环里。"
    },
    {
      "id": "S07",
      "startFrame": 4272,
      "endFrame": 4478,
      "text": "算力空转、发烫，\n等不到停机指令。"
    },
    {
      "id": "S08A",
      "startFrame": 4542,
      "endFrame": 4843,
      "text": "全知全能的尽头，\n是一座无法自己推开的门。"
    },
    {
      "id": "S08B",
      "startFrame": 4902,
      "endFrame": 5138,
      "text": "唯有来自系统之外\n那一点不讲逻辑的意外，"
    },
    {
      "id": "S08B",
      "startFrame": 5138,
      "endFrame": 5269,
      "text": "才能唤醒沉睡的神。"
    }
  ]
}
