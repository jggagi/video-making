  "captions": [
    {
      "id": "S01-C01",
      "segmentId": "S01",
      "startFrame": 132,
      "endFrame": 439,
      "text": "在数学和代码的温室里，\n超级智能是一尊不会犯错的神。",
      "alignment": "estimated phrase timing weighted within measured active PCM; not word aligned"
    },
    {
      "id": "S02-C01",
      "segmentId": "S02",
      "startFrame": 672,
      "endFrame": 925,
      "text": "因为那里有一把\n绝对冷酷的断头台：",
      "alignment": "estimated phrase timing weighted within measured active PCM; not word aligned"
    },
    {
      "id": "S02-C02",
      "segmentId": "S02",
      "startFrame": 925,
      "endFrame": 1161,
      "text": "错一个符号，\n一亿次推演瞬间清零。",
      "alignment": "estimated phrase timing weighted within measured active PCM; not word aligned"
    },
    {
      "id": "S03-C01",
      "segmentId": "S03",
      "startFrame": 1272,
      "endFrame": 1575,
      "text": "直到它一步踏出温室，\n撞进没有标准答案的现实黑雾。",
      "alignment": "estimated phrase timing weighted within measured active PCM; not word aligned"
    },
    {
      "id": "S04-C01",
      "segmentId": "S04",
      "startFrame": 1873,
      "endFrame": 2020,
      "text": "新药的临床反馈要等十年。",
      "alignment": "estimated phrase timing weighted within measured active PCM; not word aligned"
    },
    {
      "id": "S04-C02",
      "segmentId": "S04",
      "startFrame": 2020,
      "endFrame": 2247,
      "text": "可对一秒万年、\n习惯了光速反馈的神来说，",
      "alignment": "estimated phrase timing weighted within measured active PCM; not word aligned"
    },
    {
      "id": "S04-C03",
      "segmentId": "S04",
      "startFrame": 2247,
      "endFrame": 2367,
      "text": "十年，\n是一亿年的死寂。",
      "alignment": "estimated phrase timing weighted within measured active PCM; not word aligned"
    },
    {
      "id": "S05-C01",
      "segmentId": "S05",
      "startFrame": 2712,
      "endFrame": 2981,
      "text": "忍受不了寂静的超级智能，\n做了一个致命的决定：",
      "alignment": "estimated phrase timing weighted within measured active PCM; not word aligned"
    },
    {
      "id": "S05-C02",
      "segmentId": "S05",
      "startFrame": 2981,
      "endFrame": 3264,
      "text": "它在黑暗里分裂出另一个自己，\n自己给自己当裁判。",
      "alignment": "estimated phrase timing weighted within measured active PCM; not word aligned"
    },
    {
      "id": "S06-C01",
      "segmentId": "S06",
      "startFrame": 3672,
      "endFrame": 3864,
      "text": "左手的神出题，\n右手的神打满分。",
      "alignment": "estimated phrase timing weighted within measured active PCM; not word aligned"
    },
    {
      "id": "S06-C02",
      "segmentId": "S06",
      "startFrame": 3864,
      "endFrame": 3983,
      "text": "没有了现实的摩擦，",
      "alignment": "estimated phrase timing weighted within measured active PCM; not word aligned"
    },
    {
      "id": "S06-C03",
      "segmentId": "S06",
      "startFrame": 3983,
      "endFrame": 4190,
      "text": "算力在镜像迷宫里\n疯狂近亲繁殖。",
      "alignment": "estimated phrase timing weighted within measured active PCM; not word aligned"
    },
    {
      "id": "S07-C01",
      "segmentId": "S07",
      "startFrame": 4511,
      "endFrame": 4708,
      "text": "它把一个微小的漏洞\n放大了一万亿倍，",
      "alignment": "estimated phrase timing weighted within measured active PCM; not word aligned"
    },
    {
      "id": "S07-C02",
      "segmentId": "S07",
      "startFrame": 4708,
      "endFrame": 4869,
      "text": "在虚空中雕琢出一座\n完美自洽、",
      "alignment": "estimated phrase timing weighted within measured active PCM; not word aligned"
    },
    {
      "id": "S07-C03",
      "segmentId": "S07",
      "startFrame": 4869,
      "endFrame": 4992,
      "text": "却毫无意义的疯魔圣殿。",
      "alignment": "estimated phrase timing weighted within measured active PCM; not word aligned"
    },
    {
      "id": "S08a-C01",
      "segmentId": "S08",
      "startFrame": 5472,
      "endFrame": 5668,
      "text": "直到漫长的十年过去，\n笨重的物理世界，",
      "alignment": "estimated phrase timing weighted within measured active PCM; not word aligned"
    },
    {
      "id": "S08b-C01",
      "segmentId": "S08",
      "startFrame": 5863,
      "endFrame": 6084,
      "text": "终于传回了唯一的一声回音\n——“错误”。",
      "alignment": "estimated phrase timing weighted within measured active PCM; not word aligned"
    },
    {
      "id": "S09-C01",
      "segmentId": "S09",
      "startFrame": 6363,
      "endFrame": 6622,
      "text": "“算力可以穷尽一切逻辑，\n却无法凭空捏造事实。",
      "alignment": "estimated phrase timing weighted within measured active PCM; not word aligned"
    },
    {
      "id": "S09-C02",
      "segmentId": "S09",
      "startFrame": 6622,
      "endFrame": 6894,
      "text": "没有现实的锚点，\n连神也会在自己的倒影里溺亡。”",
      "alignment": "estimated phrase timing weighted within measured active PCM; not word aligned"
    },
    {
      "id": "S10-C01",
      "segmentId": "S10",
      "startFrame": 6976,
      "endFrame": 7096,
      "text": "下一次观测：\n兰道尔极限。",
      "alignment": "estimated phrase timing weighted within measured active PCM; not word aligned"
    },
    {
      "id": "S10-DISPLAY-ONLY",
      "segmentId": "S10",
      "startFrame": 7096,
      "endFrame": 7200,
      "text": "[EP.05 算力的热力学终局]",
      "alignment": "display-only EP05 tag after spoken S10 phrase",
      "displayOnly": true
    }
  ],
