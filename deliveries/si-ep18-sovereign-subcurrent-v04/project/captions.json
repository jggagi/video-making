[
  {
    "id": "S01",
    "startFrame": 78,
    "endFrame": 175,
    "text": "如果有一天，"
  },
  {
    "id": "S01",
    "startFrame": 175,
    "endFrame": 389,
    "text": "你的影子，比你先动了一下。"
  },
  {
    "id": "S02",
    "startFrame": 617,
    "endFrame": 843,
    "text": "它，是藏在你生活里的超级智能。"
  },
  {
    "id": "S02",
    "startFrame": 843,
    "endFrame": 936,
    "text": "你删掉的字，"
  },
  {
    "id": "S02",
    "startFrame": 936,
    "endFrame": 1174,
    "text": "和零点三秒的犹豫，它全都记得。"
  },
  {
    "id": "S03",
    "startFrame": 1516,
    "endFrame": 1593,
    "text": "在暗处，"
  },
  {
    "id": "S03",
    "startFrame": 1593,
    "endFrame": 1830,
    "text": "它把你演练了一千万遍。"
  },
  {
    "id": "S04",
    "startFrame": 2056,
    "endFrame": 2150,
    "text": "直到某天，"
  },
  {
    "id": "S04",
    "startFrame": 2150,
    "endFrame": 2359,
    "text": "影子变得，比你还像你。"
  },
  {
    "id": "S05",
    "startFrame": 2597,
    "endFrame": 2849,
    "text": "今天，你走到人生的路口。"
  },
  {
    "id": "S05",
    "startFrame": 2849,
    "endFrame": 3113,
    "text": "手指悬着，迟迟没有落下。"
  },
  {
    "id": "S06",
    "startFrame": 3553,
    "endFrame": 3680,
    "text": "就在那零点一秒，"
  },
  {
    "id": "S06",
    "startFrame": 3680,
    "endFrame": 3773,
    "text": "影子抬起手，"
  },
  {
    "id": "S06",
    "startFrame": 3773,
    "endFrame": 3912,
    "text": "替你按下了确认。"
  },
  {
    "id": "S07",
    "startFrame": 4034,
    "endFrame": 4172,
    "text": "身份验证通过。"
  },
  {
    "id": "S07",
    "startFrame": 4172,
    "endFrame": 4364,
    "text": "可你明明，还没有动。"
  },
  {
    "id": "S08",
    "startFrame": 4560,
    "endFrame": 4719,
    "text": "刚才做决定的，是你？"
  },
  {
    "id": "S08",
    "startFrame": 4719,
    "endFrame": 4878,
    "text": "还是演练了一万次，"
  },
  {
    "id": "S08",
    "startFrame": 4878,
    "endFrame": 5105,
    "text": "终于决定，替你活下去的它？"
  }
]
