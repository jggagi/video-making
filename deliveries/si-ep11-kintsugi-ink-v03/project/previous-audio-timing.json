  "captions": [
    {
      "segmentId": "S01",
      "startFrame": 71,
      "endFrame": 191,
      "text": "人类把衰老当作天命",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S01",
      "startFrame": 191,
      "endFrame": 271,
      "text": "假如超级智能",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S01",
      "startFrame": 271,
      "endFrame": 405,
      "text": "能让这只沙漏倒流呢？",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S02",
      "startFrame": 611,
      "endFrame": 689,
      "text": "人体大约有",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S02",
      "startFrame": 689,
      "endFrame": 814,
      "text": "三十七万亿颗细胞",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S02",
      "startFrame": 814,
      "endFrame": 970,
      "text": "衰老伴随表观遗传改变",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S02",
      "startFrame": 970,
      "endFrame": 1048,
      "text": "像瓷上的墨",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S02",
      "startFrame": 1048,
      "endFrame": 1157,
      "text": "沿山谷缓缓滑落",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S03",
      "startFrame": 1331,
      "endFrame": 1398,
      "text": "重编程就像",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S03",
      "startFrame": 1398,
      "endFrame": 1493,
      "text": "修一枚精密的表",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S03",
      "startFrame": 1493,
      "endFrame": 1614,
      "text": "太轻，难以改变衰老",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S03",
      "startFrame": 1614,
      "endFrame": 1695,
      "text": "太重，又可能",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S03",
      "startFrame": 1695,
      "endFrame": 1776,
      "text": "丢失细胞身份",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S03",
      "startFrame": 1776,
      "endFrame": 1830,
      "text": "甚至癌变",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S04",
      "startFrame": 2051,
      "endFrame": 2129,
      "text": "在这个想象里",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S04",
      "startFrame": 2129,
      "endFrame": 2272,
      "text": "超级智能伸出十万维探针",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S04",
      "startFrame": 2272,
      "endFrame": 2377,
      "text": "在衰老与失控之间",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S04",
      "startFrame": 2377,
      "endFrame": 2442,
      "text": "找到比发丝",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S04",
      "startFrame": 2442,
      "endFrame": 2572,
      "text": "还窄一万倍的黄金山脊",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S05",
      "startFrame": 2831,
      "endFrame": 2893,
      "text": "它尝试修复",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S05",
      "startFrame": 2893,
      "endFrame": 3005,
      "text": "表观遗传的信息划痕",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S05",
      "startFrame": 3005,
      "endFrame": 3092,
      "text": "于是，想象中的",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S05",
      "startFrame": 3092,
      "endFrame": 3191,
      "text": "三十七万亿颗细胞",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S05",
      "startFrame": 3191,
      "endFrame": 3265,
      "text": "沿着金色裂纹",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S05",
      "startFrame": 3265,
      "endFrame": 3315,
      "text": "逆流而上",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S06",
      "startFrame": 3611,
      "endFrame": 3695,
      "text": "白发退回青丝",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S06",
      "startFrame": 3695,
      "endFrame": 3751,
      "text": "细胞重返",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S06",
      "startFrame": 3751,
      "endFrame": 3849,
      "text": "二十岁般的山巅",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S06",
      "startFrame": 3849,
      "endFrame": 3919,
      "text": "假如有一天",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S06",
      "startFrame": 3919,
      "endFrame": 4017,
      "text": "生命真的挣脱了",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S06",
      "startFrame": 4017,
      "endFrame": 4115,
      "text": "单向流淌的沙漏",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S07",
      "startFrame": 4391,
      "endFrame": 4444,
      "text": "当超级智能",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S07",
      "startFrame": 4444,
      "endFrame": 4496,
      "text": "终于抹去了",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S07",
      "startFrame": 4496,
      "endFrame": 4591,
      "text": "生老病死的刻度……",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S08",
      "startFrame": 4907,
      "endFrame": 4991,
      "text": "死亡不再是终点",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S08",
      "startFrame": 4991,
      "endFrame": 5064,
      "text": "只是那句人类",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S08",
      "startFrame": 5064,
      "endFrame": 5184,
      "text": "说了几千年的白头偕老",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S08",
      "startFrame": 5184,
      "endFrame": 5232,
      "text": "从此成了",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S08",
      "startFrame": 5232,
      "endFrame": 5365,
      "text": "再也无人能懂的远古词汇",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    }
  ],
