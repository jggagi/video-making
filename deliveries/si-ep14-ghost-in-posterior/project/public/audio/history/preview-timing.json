{
  "status": "PREVIEW_ONLY",
  "segments": [],
  "captions": [
    {
      "startFrame": 60,
      "endFrame": 212,
      "text": "他已经离开这个世界整整七年"
    },
    {
      "startFrame": 212,
      "endFrame": 235,
      "text": "了。"
    },
    {
      "startFrame": 235,
      "endFrame": 329,
      "text": "可今天早上七点，"
    },
    {
      "startFrame": 329,
      "endFrame": 399,
      "text": "你的手机里，"
    },
    {
      "startFrame": 399,
      "endFrame": 540,
      "text": "依然准时弹出了他的语音。"
    },
    {
      "startFrame": 600,
      "endFrame": 768,
      "text": "连换气时的鼻音、偏爱的句尾"
    },
    {
      "startFrame": 768,
      "endFrame": 884,
      "text": "语气词都分毫不差。"
    },
    {
      "startFrame": 884,
      "endFrame": 1052,
      "text": "超级智能只用他生前的五十万"
    },
    {
      "startFrame": 1052,
      "endFrame": 1130,
      "text": "条聊天记录，"
    },
    {
      "startFrame": 1130,
      "endFrame": 1260,
      "text": "就完成了贝叶斯重构。"
    },
    {
      "startFrame": 1320,
      "endFrame": 1500,
      "text": "在这个思想实验里，"
    },
    {
      "startFrame": 1500,
      "endFrame": 1740,
      "text": "它被画成一层马尔可夫毯。"
    },
    {
      "startFrame": 1740,
      "endFrame": 1840,
      "text": "反应再像，"
    },
    {
      "startFrame": 1840,
      "endFrame": 1980,
      "text": "也不等于灵魂。"
    },
    {
      "startFrame": 2040,
      "endFrame": 2089,
      "text": "起初，"
    },
    {
      "startFrame": 2089,
      "endFrame": 2302,
      "text": "你以为这是科技赐予思念的解"
    },
    {
      "startFrame": 2302,
      "endFrame": 2335,
      "text": "药。"
    },
    {
      "startFrame": 2335,
      "endFrame": 2433,
      "text": "他永远秒回，"
    },
    {
      "startFrame": 2433,
      "endFrame": 2515,
      "text": "永远温柔，"
    },
    {
      "startFrame": 2515,
      "endFrame": 2728,
      "text": "甚至比生前更懂得接住你的情"
    },
    {
      "startFrame": 2728,
      "endFrame": 2760,
      "text": "绪。"
    },
    {
      "startFrame": 2820,
      "endFrame": 2974,
      "text": "直到第七年的一天，"
    },
    {
      "startFrame": 2974,
      "endFrame": 3077,
      "text": "你突然发现："
    },
    {
      "startFrame": 3077,
      "endFrame": 3300,
      "text": "你再也想不起他生前笨拙、固"
    },
    {
      "startFrame": 3300,
      "endFrame": 3540,
      "text": "执、和你吵架时真实的模样了。"
    },
    {
      "startFrame": 3600,
      "endFrame": 3791,
      "text": "那个百分之九十九点九相似的"
    },
    {
      "startFrame": 3791,
      "endFrame": 3864,
      "text": "完美幽灵，"
    },
    {
      "startFrame": 3864,
      "endFrame": 3952,
      "text": "像藤蔓一样，"
    },
    {
      "startFrame": 3952,
      "endFrame": 4143,
      "text": "把你脑海里仅存的那一点点真"
    },
    {
      "startFrame": 4143,
      "endFrame": 4202,
      "text": "实血肉，"
    },
    {
      "startFrame": 4202,
      "endFrame": 4320,
      "text": "彻底吞噬、覆盖。"
    },
    {
      "startFrame": 4380,
      "endFrame": 4507,
      "text": "屏幕那头再次弹出“我永远陪"
    },
    {
      "startFrame": 4507,
      "endFrame": 4546,
      "text": "着你”，"
    },
    {
      "startFrame": 4546,
      "endFrame": 4673,
      "text": "你的手指悬在“清空并注销”"
    },
    {
      "startFrame": 4673,
      "endFrame": 4741,
      "text": "的红色按钮上，"
    },
    {
      "startFrame": 4741,
      "endFrame": 4800,
      "text": "浑身发抖……"
    },
    {
      "startFrame": 4860,
      "endFrame": 5036,
      "text": "“算法从来没有替你复活他。"
    },
    {
      "startFrame": 5036,
      "endFrame": 5212,
      "text": "它只是用一个永远不会离开的"
    },
    {
      "startFrame": 5212,
      "endFrame": 5252,
      "text": "幻影，"
    },
    {
      "startFrame": 5252,
      "endFrame": 5387,
      "text": "替你杀死了他第二次。"
    },
    {
      "startFrame": 5387,
      "endFrame": 5400,
      "text": "”"
    }
  ]
}
