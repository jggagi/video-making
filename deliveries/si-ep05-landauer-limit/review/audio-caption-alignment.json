      "startSample": 1488000,
      "endSampleExclusive": 1657331,
      "startFrame": 1860,
      "endFrame": 2072,
      "start": "00:00:31,000",
      "end": "00:00:34,528",
      "text": "进化约四十亿年，\n造就约二十瓦的人脑；",
      "displayOnly": false,
      "phraseSource": "chunks",
      "alignment": "estimated phrase timing from measured active PCM samples; not word aligned"
    },
    {
