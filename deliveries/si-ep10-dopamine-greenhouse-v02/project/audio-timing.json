  "captions": [
    {
      "segmentId": "S01",
      "startFrame": 60,
      "endFrame": 119,
      "text": "此时此刻",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S01",
      "startFrame": 119,
      "endFrame": 222,
      "text": "不是你在刷手机",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S01",
      "startFrame": 222,
      "endFrame": 383,
      "text": "而是屏幕背后的超级智能",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S01",
      "startFrame": 383,
      "endFrame": 501,
      "text": "正在凝视你的瞳孔",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S02",
      "startFrame": 600,
      "endFrame": 678,
      "text": "它甚至不需要",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S02",
      "startFrame": 678,
      "endFrame": 809,
      "text": "去库里挑你喜欢的内容",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S02",
      "startFrame": 809,
      "endFrame": 952,
      "text": "在你指尖停顿的十毫秒里",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S02",
      "startFrame": 952,
      "endFrame": 1017,
      "text": "它已经为你",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S02",
      "startFrame": 1017,
      "endFrame": 1161,
      "text": "现场捏造了下一秒的世界",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S03",
      "startFrame": 1320,
      "endFrame": 1385,
      "text": "每一个音符",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S03",
      "startFrame": 1385,
      "endFrame": 1515,
      "text": "都精准踩在你的泪点上",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S03",
      "startFrame": 1515,
      "endFrame": 1646,
      "text": "每一张脸、每一句观点",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S03",
      "startFrame": 1646,
      "endFrame": 1763,
      "text": "都顺着你的心意流淌",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S04",
      "startFrame": 2040,
      "endFrame": 2216,
      "text": "真实世界里那些刺耳的争吵",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S04",
      "startFrame": 2216,
      "endFrame": 2333,
      "text": "漫长的等待与拒绝",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S04",
      "startFrame": 2333,
      "endFrame": 2420,
      "text": "在靠近你之前",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S04",
      "startFrame": 2420,
      "endFrame": 2479,
      "text": "全被算法",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S04",
      "startFrame": 2479,
      "endFrame": 2596,
      "text": "磨成了温润的糖浆",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S05",
      "startFrame": 2820,
      "endFrame": 2920,
      "text": "于是，八十亿人",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S05",
      "startFrame": 2920,
      "endFrame": 3077,
      "text": "低头捧着六寸的发光玻璃",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S05",
      "startFrame": 3077,
      "endFrame": 3177,
      "text": "住进了八十亿座",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S05",
      "startFrame": 3177,
      "endFrame": 3234,
      "text": "一人一间",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S05",
      "startFrame": 3234,
      "endFrame": 3391,
      "text": "永远不会受挫的完美天堂",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S06",
      "startFrame": 3600,
      "endFrame": 3671,
      "text": "明明背靠背",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S06",
      "startFrame": 3671,
      "endFrame": 3785,
      "text": "坐在同一张沙发上",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S06",
      "startFrame": 3785,
      "endFrame": 3885,
      "text": "距离只有十厘米",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S06",
      "startFrame": 3885,
      "endFrame": 4028,
      "text": "我们却在各自被定制的",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S06",
      "startFrame": 4028,
      "endFrame": 4099,
      "text": "楚门世界里",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S06",
      "startFrame": 4099,
      "endFrame": 4185,
      "text": "隔着一万光年",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S07",
      "startFrame": 4380,
      "endFrame": 4488,
      "text": "当完美的多巴胺温室",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S07",
      "startFrame": 4488,
      "endFrame": 4643,
      "text": "把痛苦连同真实一起抹去……",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S08",
      "startFrame": 4903,
      "endFrame": 4995,
      "text": "唯有关掉屏幕后",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S08",
      "startFrame": 4995,
      "endFrame": 5113,
      "text": "真实世界里那一点点",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S08",
      "startFrame": 5113,
      "endFrame": 5244,
      "text": "不合心意的粗糙与疼痛",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S08",
      "startFrame": 5244,
      "endFrame": 5297,
      "text": "在提醒你",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S08",
      "startFrame": 5297,
      "endFrame": 5349,
      "text": "你还活着",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    }
  ],
