        "saved": "/Users/guoq/Documents/ChatGPT/video/public/madman/voice-v5/zhao.wav"
      }
    },
    {
      "id": "whisper",
      "shotId": "street",
      "section": "二",
      "text": "还有七八个人，交头接耳的议论我。又怕我看见。",
      "path": "public/madman/voice-v5/whisper.wav",
      "contentHash": "ad99d851cf0793f41de4601034cdb305b3466bcd1713fa540e93e2efa50315dc",
      "model": "cosyvoice-v3-flash",
