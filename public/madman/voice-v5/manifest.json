      }
    },
    {
      "id": "smile",
      "shotId": "street",
      "section": "二",
      "text": "其中最凶的一个人，张着嘴，对我笑了一笑；我便从头直冷到脚跟。",
      "path": "public/madman/voice-v5/smile.wav",
      "contentHash": "955929e0ccc60ee05402553d3cbdb2c1510a079ab4d6ed07d1d005e6f7f3d50a",
