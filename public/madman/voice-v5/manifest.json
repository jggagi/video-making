      "sourceDurationSeconds": 4.201667
    },
    {
      "id": "history-b",
      "shotId": "history",
      "section": "三",
      "text": "歪歪斜斜的每叶上都写着“仁义道德”几个字。",
      "path": "public/madman/voice-v5/history-b.wav",
      "contentHash": "bf1f0ef60cda78d2738616ffdbcd3f17f94d2c285742c2f26f2084d4b52892b0",
