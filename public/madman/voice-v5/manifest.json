    {
      "id": "history-a",
      "shotId": "history",
      "section": "三",
      "text": "我翻开历史一查，这历史没有年代，",
      "path": "public/madman/voice-v5/history-a.wav",
      "contentHash": "f6bd887eac5ecb1f12708d2e4b99e7f2c9f961dab3ac1d8fdfb858a00c13769b",
