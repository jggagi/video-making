      "reusedFromManifestSha256": "abb23cdc81bf5f925b353c49fa30c9174d4238432684d0d48edb9496506f4bf9",
      "sourceDurationSeconds": 5.378167
    },
    {
      "id": "history-c",
      "shotId": "history",
      "section": "三",
      "text": "我横竖睡不着，仔细看了半夜，才从字缝里看出字来，满本都写着两个字是“吃人”！",
      "path": "public/madman/voice-v5/history-c.wav",
      "contentHash": "ed26445f3be7c699f1646a0a4e6a28cba3fd2baa27436f8948fbcc225f598290",
