    "originalVoiceCues": [
      {
        "id": "moon-1",
        "shotId": "moon",
        "cueIndex": 0,
        "fromFrame": 144,
        "text": "今天晚上，很好的月光。",
        "audioPath": "public/madman/voice-v2/moon-1.wav",
        "sha256": "dc472ad47562cee1bfe63b4fcc765c11f491a470bafbbe30d19d8d4cd3528efb"
      },
      {
        "id": "watch-1",
        "shotId": "watch",
        "cueIndex": 0,
        "fromFrame": 336,
        "text": "今天全没月光，我知道不妙。",
        "audioPath": "public/madman/voice-v2/watch-1.wav",
        "sha256": "e6c34b9c01019bb34cdb73a4d5f74f3aa6eece096b14d19b575f245d52f832c8"
      },
      {
        "id": "watch-2",
        "shotId": "watch",
        "cueIndex": 1,
        "fromFrame": 444,
        "text": "似乎怕我，似乎想害我。",
        "audioPath": "public/madman/voice-v2/watch-2.wav",
        "sha256": "d1fe5fa5d99bd0e79f13920ee7060b13237eb2994d846cbd1c3ce279eec0300b"
      },
      {
        "id": "history-1",
        "shotId": "history",
        "cueIndex": 0,
        "fromFrame": 600,
        "text": "我翻开历史一查，这历史没有年代，",
        "audioPath": "public/madman/voice-v2/history-1.wav",
        "sha256": "00ca1e3d8e97840e625c92dbdb5eff98de124097448261ac354f3988add7004b"
      },
      {
        "id": "history-2",
        "shotId": "history",
        "cueIndex": 1,
        "fromFrame": 724,
        "text": "歪歪斜斜的每叶上都写着“仁义道德”几个字。",
        "audioPath": "public/madman/voice-v2/history-2.wav",
        "sha256": "0ba0a6e79bd78b0873d1869773d07eed2cb1796d3bcf34cc885ae4121f4c3a75"
      },
      {
        "id": "history-3",
        "shotId": "history",
        "cueIndex": 2,
        "fromFrame": 912,
        "text": "满本都写着两个字是“吃人”！",
        "audioPath": "public/madman/voice-v2/history-3.wav",
        "sha256": "6035e73f3bb451ff705b09e8571cee22121e73dec3cbb862e44545eb1b628069"
      },
      {
        "id": "question-1",
        "shotId": "question",
        "cueIndex": 0,
        "fromFrame": 1076,
        "text": "从来如此，便对么？",
        "audioPath": "public/madman/voice-v2/question-1.wav",
        "sha256": "20f28a2233f0e16e0b21b80fc34af5a23c00730691c652c6f1fe7f48a73d5c62"
      },
      {
        "id": "complicity-1",
        "shotId": "complicity",
        "cueIndex": 0,
        "fromFrame": 1272,
        "text": "四千年来时时吃人的地方，",
        "audioPath": "public/madman/voice-v2/complicity-1.wav",
        "sha256": "54d8ec84b5eddc0037620da2dea39b1b644301973018e9a62499e214131dbbc4"
      },
      {
        "id": "complicity-2",
        "shotId": "complicity",
        "cueIndex": 1,
        "fromFrame": 1380,
        "text": "今天才明白，我也在其中混了多年；",
        "audioPath": "public/madman/voice-v2/complicity-2.wav",
        "sha256": "361e0276856b4626a616335807a8515e0180005442654ce4e90c505b70f115ee"
      },
      {
        "id": "children-1",
        "shotId": "children",
        "cueIndex": 0,
        "fromFrame": 1536,
        "text": "没有吃过人的孩子，或者还有？",
        "audioPath": "public/madman/voice-v2/children-1.wav",
        "sha256": "aea6544c5c92be7edd7a88acc6db66812e037a22ff248517b9e33cf8531d89d1"
      },
      {
        "id": "plea-1",
        "shotId": "plea",
        "cueIndex": 0,
        "fromFrame": 1740,
        "text": "救救孩子……",
        "audioPath": "public/madman/voice-v2/plea-1.wav",
        "sha256": "5489b211ea52d8d178dd218f0b5f569ac4b7c04f334acee139d7e26b1d64ab67"
      }
    ],
