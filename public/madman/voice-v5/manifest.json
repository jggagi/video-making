    {
      "id": "zhao",
      "shotId": "street",
      "section": "二",
      "text": "早上小心出门，赵贵翁的眼色便怪：似乎怕我，似乎想害我。",
      "path": "public/madman/voice-v5/zhao.wav",
      "contentHash": "9b125f871c33ca80601c0e495ff5aa450df52f586484460e5056b17c1e1be93c",
      "model": "cosyvoice-v3-flash",
