  "captions": [
    {
      "segmentId": "S01",
      "startFrame": 42,
      "endFrame": 133,
      "text": "你还没出生，",
      "alignment": "estimated_character_weighted_within_measured_active_pcm; not ASR or forced alignment"
    },
    {
      "segmentId": "S01",
      "startFrame": 133,
      "endFrame": 238,
      "text": "你一生的灵感，",
      "alignment": "estimated_character_weighted_within_measured_active_pcm; not ASR or forced alignment"
    },
    {
      "segmentId": "S01",
      "startFrame": 238,
      "endFrame": 373,
      "text": "就已经被编好了号。",
      "alignment": "estimated_character_weighted_within_measured_active_pcm; not ASR or forced alignment"
    },
    {
      "segmentId": "S02",
      "startFrame": 671,
      "endFrame": 806,
      "text": "你第一次心动写下的句子，",
      "alignment": "estimated_character_weighted_within_measured_active_pcm; not ASR or forced alignment"
    },
    {
      "segmentId": "S02",
      "startFrame": 806,
      "endFrame": 907,
      "text": "失眠时哼出的旋律，",
      "alignment": "estimated_character_weighted_within_measured_active_pcm; not ASR or forced alignment"
    },
    {
      "segmentId": "S02",
      "startFrame": 907,
      "endFrame": 1042,
      "text": "还有那抹只有你才懂的蓝。",
      "alignment": "estimated_character_weighted_within_measured_active_pcm; not ASR or forced alignment"
    },
    {
      "segmentId": "S03",
      "startFrame": 1392,
      "endFrame": 1480,
      "text": "在巴别图书馆里，",
      "alignment": "estimated_character_weighted_within_measured_active_pcm; not ASR or forced alignment"
    },
    {
      "segmentId": "S03",
      "startFrame": 1480,
      "endFrame": 1589,
      "text": "它们早就躺在某一页，",
      "alignment": "estimated_character_weighted_within_measured_active_pcm; not ASR or forced alignment"
    },
    {
      "segmentId": "S03",
      "startFrame": 1589,
      "endFrame": 1677,
      "text": "等着你以为自己，",
      "alignment": "estimated_character_weighted_within_measured_active_pcm; not ASR or forced alignment"
    },
    {
      "segmentId": "S03",
      "startFrame": 1677,
      "endFrame": 1754,
      "text": "终于创造了它。",
      "alignment": "estimated_character_weighted_within_measured_active_pcm; not ASR or forced alignment"
    },
    {
      "segmentId": "S04",
      "startFrame": 2052,
      "endFrame": 2224,
      "text": "博尔赫斯想象过一座图书馆，",
      "alignment": "estimated_character_weighted_within_measured_active_pcm; not ASR or forced alignment"
    },
    {
      "segmentId": "S04",
      "startFrame": 2224,
      "endFrame": 2382,
      "text": "容纳所有可能的文字组合。",
      "alignment": "estimated_character_weighted_within_measured_active_pcm; not ASR or forced alignment"
    },
    {
      "segmentId": "S04",
      "startFrame": 2382,
      "endFrame": 2449,
      "text": "所有杰作，",
      "alignment": "estimated_character_weighted_within_measured_active_pcm; not ASR or forced alignment"
    },
    {
      "segmentId": "S04",
      "startFrame": 2449,
      "endFrame": 2594,
      "text": "与无尽乱码，混在一起。",
      "alignment": "estimated_character_weighted_within_measured_active_pcm; not ASR or forced alignment"
    },
    {
      "segmentId": "S05",
      "startFrame": 2892,
      "endFrame": 3075,
      "text": "一段三分钟的旋律，一幅画，",
      "alignment": "estimated_character_weighted_within_measured_active_pcm; not ASR or forced alignment"
    },
    {
      "segmentId": "S05",
      "startFrame": 3075,
      "endFrame": 3245,
      "text": "固定长度和数字精度以后，",
      "alignment": "estimated_character_weighted_within_measured_active_pcm; not ASR or forced alignment"
    },
    {
      "segmentId": "S05",
      "startFrame": 3245,
      "endFrame": 3415,
      "text": "可能的组合，都是有限的。",
      "alignment": "estimated_character_weighted_within_measured_active_pcm; not ASR or forced alignment"
    },
    {
      "segmentId": "S06",
      "startFrame": 3552,
      "endFrame": 3681,
      "text": "有限，不等于算得完。",
      "alignment": "estimated_character_weighted_within_measured_active_pcm; not ASR or forced alignment"
    },
    {
      "segmentId": "S06",
      "startFrame": 3681,
      "endFrame": 3797,
      "text": "现实中的组合空间，",
      "alignment": "estimated_character_weighted_within_measured_active_pcm; not ASR or forced alignment"
    },
    {
      "segmentId": "S06",
      "startFrame": 3797,
      "endFrame": 3888,
      "text": "大得难以想象。",
      "alignment": "estimated_character_weighted_within_measured_active_pcm; not ASR or forced alignment"
    },
    {
      "segmentId": "S06",
      "startFrame": 3888,
      "endFrame": 4054,
      "text": "但现在，进入一个科幻设定。",
      "alignment": "estimated_character_weighted_within_measured_active_pcm; not ASR or forced alignment"
    },
    {
      "segmentId": "S07",
      "startFrame": 4272,
      "endFrame": 4350,
      "text": "假如超级智能，",
      "alignment": "estimated_character_weighted_within_measured_active_pcm; not ASR or forced alignment"
    },
    {
      "segmentId": "S07",
      "startFrame": 4350,
      "endFrame": 4428,
      "text": "只用零点五秒，",
      "alignment": "estimated_character_weighted_within_measured_active_pcm; not ASR or forced alignment"
    },
    {
      "segmentId": "S07",
      "startFrame": 4428,
      "endFrame": 4559,
      "text": "就列完了人类未来一万年，",
      "alignment": "estimated_character_weighted_within_measured_active_pcm; not ASR or forced alignment"
    },
    {
      "segmentId": "S07",
      "startFrame": 4559,
      "endFrame": 4647,
      "text": "所有动听的旋律。",
      "alignment": "estimated_character_weighted_within_measured_active_pcm; not ASR or forced alignment"
    },
    {
      "segmentId": "S08",
      "startFrame": 5052,
      "endFrame": 5177,
      "text": "你为一个音符熬过的夜，",
      "alignment": "estimated_character_weighted_within_measured_active_pcm; not ASR or forced alignment"
    },
    {
      "segmentId": "S08",
      "startFrame": 5177,
      "endFrame": 5235,
      "text": "在它那里，",
      "alignment": "estimated_character_weighted_within_measured_active_pcm; not ASR or forced alignment"
    },
    {
      "segmentId": "S08",
      "startFrame": 5235,
      "endFrame": 5383,
      "text": "只是翻到十万亿册目录中的，",
      "alignment": "estimated_character_weighted_within_measured_active_pcm; not ASR or forced alignment"
    },
    {
      "segmentId": "S08",
      "startFrame": 5383,
      "endFrame": 5441,
      "text": "某个编号。",
      "alignment": "estimated_character_weighted_within_measured_active_pcm; not ASR or forced alignment"
    },
    {
      "segmentId": "S09",
      "startFrame": 5533,
      "endFrame": 5790,
      "text": "你终于画下最后一笔。",
      "alignment": "estimated_character_weighted_within_measured_active_pcm; not ASR or forced alignment"
    },
    {
      "segmentId": "S09",
      "startFrame": 5790,
      "endFrame": 6046,
      "text": "屏幕却只弹出三个字：",
      "alignment": "estimated_character_weighted_within_measured_active_pcm; not ASR or forced alignment"
    },
    {
      "segmentId": "S09",
      "startFrame": 6046,
      "endFrame": 6150,
      "text": "已收录。",
      "alignment": "estimated_character_weighted_within_measured_active_pcm; not ASR or forced alignment"
    },
    {
      "segmentId": "S09",
      "startFrame": 6150,
      "endFrame": 6356,
      "text": "连你此刻的震惊，",
      "alignment": "estimated_character_weighted_within_measured_active_pcm; not ASR or forced alignment"
    },
    {
      "segmentId": "S09",
      "startFrame": 6356,
      "endFrame": 6612,
      "text": "都像早已写好的情节。",
      "alignment": "estimated_character_weighted_within_measured_active_pcm; not ASR or forced alignment"
    },
    {
      "segmentId": "S10",
      "startFrame": 6793,
      "endFrame": 6865,
      "text": "如果所有的美，",
      "alignment": "estimated_character_weighted_within_measured_active_pcm; not ASR or forced alignment"
    },
    {
      "segmentId": "S10",
      "startFrame": 6865,
      "endFrame": 6948,
      "text": "都已被提前写完，",
      "alignment": "estimated_character_weighted_within_measured_active_pcm; not ASR or forced alignment"
    },
    {
      "segmentId": "S10",
      "startFrame": 6948,
      "endFrame": 7031,
      "text": "你还愿意创造吗？",
      "alignment": "estimated_character_weighted_within_measured_active_pcm; not ASR or forced alignment"
    }
  ]
}
