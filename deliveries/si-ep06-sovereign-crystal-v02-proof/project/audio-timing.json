  "status": "measured_pcm_with_estimated_phrase_timing",
  "captions": [
    {
      "segmentId": "S01",
      "startFrame": 120,
      "endFrame": 293,
      "text": "如果有一个存在，\n比你早半秒知道，"
    },
    {
      "segmentId": "S01",
      "startFrame": 293,
      "endFrame": 392,
      "text": "你下一句想说什么。"
    },
    {
      "segmentId": "S02",
      "startFrame": 660,
      "endFrame": 921,
      "text": "实验中，平均准备电位\n在动作前约550毫秒出现；"
    },
    {
      "segmentId": "S02",
      "startFrame": 921,
      "endFrame": 1125,
      "text": "主观意图报告，\n约在动作前200毫秒。"
    },
    {
      "segmentId": "S03",
      "startFrame": 1320,
      "endFrame": 1616,
      "text": "这350毫秒的间隙，令人不安。\n但它不等于读心，"
    },
    {
      "segmentId": "S03",
      "startFrame": 1616,
      "endFrame": 1771,
      "text": "更没有证明人生早已注定。"
    },
    {
      "segmentId": "S04",
      "startFrame": 1860,
      "endFrame": 2126,
      "text": "指尖的停顿，视线的游移，\n都可能成为预测线索。"
    },
    {
      "segmentId": "S04",
      "startFrame": 2126,
      "endFrame": 2381,
      "text": "看，这个数字镜像，\n只是延迟坐标重构的模拟。"
    },
    {
      "segmentId": "S05",
      "startFrame": 2700,
      "endFrame": 2941,
      "text": "在这个模拟系统里，\n轨迹误差逼近零。"
    },
    {
      "segmentId": "S05",
      "startFrame": 2941,
      "endFrame": 3267,
      "text": "但人不是洛伦兹方程，\n误差更不是自由意志的刻度。"
    },
    {
      "segmentId": "S06",
      "startFrame": 3660,
      "endFrame": 3921,
      "text": "算法能从行为推测偏好，\n再改变你看到的选项。"
    },
    {
      "segmentId": "S06",
      "startFrame": 3921,
      "endFrame": 4183,
      "text": "不用强迫，只需把某条路，\n铺得比别的路更顺。"
    },
    {
      "segmentId": "S07",
      "startFrame": 4500,
      "endFrame": 4782,
      "text": "最可怕的囚笼，\n从没有铁栏杆。"
    },
    {
      "segmentId": "S07",
      "startFrame": 4782,
      "endFrame": 5225,
      "text": "是当选择被悄悄塑形，\n你却看不见那只温柔的手。"
    },
    {
      "segmentId": "S08",
      "startFrame": 5430,
      "endFrame": 5690,
      "text": "主权心印。\n让本地守卫，替你守住边界。"
    },
    {
      "segmentId": "S09",
      "startFrame": 6020,
      "endFrame": 6245,
      "text": "把记忆锁进私密的圣殿，\n用你的硅基分身"
    },
    {
      "segmentId": "S09",
      "startFrame": 6245,
      "endFrame": 6533,
      "text": "去对抗全世界的算法。\n守住那百分之一的不可预测，"
    },
    {
      "segmentId": "S09",
      "startFrame": 6533,
      "endFrame": 6683,
      "text": "才守住了生而为人的自由。"
    },
    {
      "segmentId": "S10",
      "startFrame": 6960,
      "endFrame": 7120,
      "text": "一眼万年，第一季。\n观测完毕。"
    }
  ]
}
