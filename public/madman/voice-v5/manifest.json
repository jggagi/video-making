      "voiceReportedByCli": true,
      "rate": 0.92,
      "format": "wav",
      "sampleRate": 24000,
      "channels": 1,
      "codec": "pcm_s16le",
      "bitsPerSample": 16,
      "durationSeconds": 9.159667,
      "sha256": "1c6b3c5a5893ecac5e8c5746df8d5a558a5f8f6fd153e645dda073d1dabc0cd5",
      "origin": "bailian-synthesis",
      "providerMetadata": {
