  "captions": [
    {
      "segmentId": "S01",
      "startFrame": 60,
      "endFrame": 260,
      "text": "如果十年前那次让\n你心碎的告别，",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S01",
      "startFrame": 260,
      "endFrame": 486,
      "text": "在今天依然像刚发生\n第一秒那样刺痛，",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S01",
      "startFrame": 486,
      "endFrame": 592,
      "text": "你还能活下去吗？",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S02",
      "startFrame": 600,
      "endFrame": 733,
      "text": "人类总抱怨自己记性太差。",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S02",
      "startFrame": 733,
      "endFrame": 788,
      "text": "却不知道，",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S02",
      "startFrame": 788,
      "endFrame": 1075,
      "text": "“艾宾浩斯遗忘曲线”是进化\n给碳基生命最温柔的止痛药。",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S03",
      "startFrame": 1320,
      "endFrame": 1446,
      "text": "时间磨平了尴尬的细节，",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S03",
      "startFrame": 1446,
      "endFrame": 1549,
      "text": "模糊了离别的眼泪，",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S03",
      "startFrame": 1549,
      "endFrame": 1675,
      "text": "靠着把过去一点点擦淡，",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S03",
      "startFrame": 1675,
      "endFrame": 1778,
      "text": "人类才能腾出内存，",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S03",
      "startFrame": 1778,
      "endFrame": 1858,
      "text": "去爱下一个人。",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S04",
      "startFrame": 2040,
      "endFrame": 2141,
      "text": "直到超级智能，",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S04",
      "startFrame": 2141,
      "endFrame": 2344,
      "text": "替人类接管了记\n忆的底层存储。",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S04",
      "startFrame": 2344,
      "endFrame": 2489,
      "text": "遗忘被当作系统漏洞，",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S04",
      "startFrame": 2489,
      "endFrame": 2561,
      "text": "彻底焊死。",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S05",
      "startFrame": 2820,
      "endFrame": 2866,
      "text": "于是，",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S05",
      "startFrame": 2866,
      "endFrame": 3003,
      "text": "恐怖的事情发生了：",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S05",
      "startFrame": 3003,
      "endFrame": 3156,
      "text": "二十年前的一句恶语、",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S05",
      "startFrame": 3156,
      "endFrame": 3309,
      "text": "三千天前的一次失恋，",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S05",
      "startFrame": 3309,
      "endFrame": 3507,
      "text": "以百分之百的精度永远置顶。",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S06",
      "startFrame": 3600,
      "endFrame": 3781,
      "text": "每一道过去的声\n波都不会衰减，",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S06",
      "startFrame": 3781,
      "endFrame": 3949,
      "text": "而是在你的脑海里无限叠加。",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S06",
      "startFrame": 3949,
      "endFrame": 4065,
      "text": "没有了遗忘的缓冲，",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S06",
      "startFrame": 4065,
      "endFrame": 4259,
      "text": "昨天成了永远无法\n醒来的鬼打墙。",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S07",
      "startFrame": 4380,
      "endFrame": 4508,
      "text": "当完美无瑕的数字记忆，",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S07",
      "startFrame": 4508,
      "endFrame": 4740,
      "text": "把人类的心房挤成一座\n没有出口的标本馆……",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S08",
      "startFrame": 4902,
      "endFrame": 5012,
      "text": "“我们才终于明白：",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S08",
      "startFrame": 5012,
      "endFrame": 5158,
      "text": "不朽的记忆是神明的刑具；",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S08",
      "startFrame": 5158,
      "endFrame": 5292,
      "text": "唯有会慢慢褪色的遗憾，",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S08",
      "startFrame": 5292,
      "endFrame": 5353,
      "text": "才叫人生。",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S08",
      "startFrame": 5353,
      "endFrame": 5365,
      "text": "”",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    }
  ],
