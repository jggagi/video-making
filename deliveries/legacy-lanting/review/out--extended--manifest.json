{
  "model": "cosyvoice-v3-flash",
  "voice": "longsanshu_v3",
  "format": "wav",
  "sampleRate": 24000,
  "channels": 1,
  "cues": [
    {
      "sceneId": "date",
      "cueIndex": 1,
      "contentHash": "1db94f67f4f99972097d5e62a9df573948cc1e129c40d5b621e2700ec1cf0132",
      "model": "cosyvoice-v3-flash",
      "voice": "longsanshu_v3",
      "rate": 0.82,
      "format": "wav",
      "sampleRate": 24000,
      "text": "永和九年，岁在癸丑，暮春之初，",
      "path": "out/extended/speech/cue-1db94f67f4f99972097d5e62a9df573948cc1e129c40d5b621e2700ec1cf0132.wav",
      "sha256": "3011ea1ab9f511d65c65fc9a8d8c41959f0f5608c3348558f7752c5467300fa9",
      "durationSeconds": 5.919291666666667
    },
    {
      "sceneId": "date",
      "cueIndex": 2,
      "contentHash": "5ea5655bfdea6d6a2706ed2fa15720e26d760a321879bef3f34ba2078d61362b",
      "model": "cosyvoice-v3-flash",
      "voice": "longsanshu_v3",
      "rate": 0.82,
      "format": "wav",
      "sampleRate": 24000,
      "text": "会于会稽山阴之兰亭，修禊事也。",
      "path": "out/extended/speech/cue-5ea5655bfdea6d6a2706ed2fa15720e26d760a321879bef3f34ba2078d61362b.wav",
      "sha256": "1d02eff32b09116b72c2e46afd1cad0826c9cd51d34cfa291f90d32e8ade4007",
      "durationSeconds": 4.663666666666667
    },
    {
      "sceneId": "grove",
      "cueIndex": 1,
      "contentHash": "9e9d9ba1f76ad1e2440574c26de6fe20af8e52bf0f26aa56ebcf3f42e7a72fee",
      "model": "cosyvoice-v3-flash",
      "voice": "longsanshu_v3",
      "rate": 0.82,
      "format": "wav",
      "sampleRate": 24000,
      "text": "群贤毕至，少长咸集。此地有崇山峻岭，",
      "path": "out/extended/speech/cue-9e9d9ba1f76ad1e2440574c26de6fe20af8e52bf0f26aa56ebcf3f42e7a72fee.wav",
      "sha256": "3f11fe80570bfa5ca9ef2124d43e7274c4af0df2ca4823fc1f223748cb2ecf63",
      "durationSeconds": 6.1883333333333335
    },
    {
      "sceneId": "grove",
      "cueIndex": 2,
      "contentHash": "94631f211a187b2b15513234d44111ff6cfeb07b1e00a3de1a4ddc5da3c9b5e6",
      "model": "cosyvoice-v3-flash",
      "voice": "longsanshu_v3",
      "rate": 0.82,
      "format": "wav",
      "sampleRate": 24000,
      "text": "茂林修竹。",
      "path": "out/extended/speech/cue-94631f211a187b2b15513234d44111ff6cfeb07b1e00a3de1a4ddc5da3c9b5e6.wav",
      "sha256": "16fd7db5c9b80c08875dfe431615e510e50035cbe50a099a1ae4cf6b86efb8d4",
      "durationSeconds": 2.152458333333333
    },
    {
      "sceneId": "water",
      "cueIndex": 1,
      "contentHash": "d86c75476195e260ea205cabfa04833d10bb2b05ad76e45d739c65f4338eab2e",
      "model": "cosyvoice-v3-flash",
      "voice": "longsanshu_v3",
      "rate": 0.82,
      "format": "wav",
      "sampleRate": 24000,
      "text": "又有清流激湍，映带左右。",
      "path": "out/extended/speech/cue-d86c75476195e260ea205cabfa04833d10bb2b05ad76e45d739c65f4338eab2e.wav",
      "sha256": "18930c2980fb900041010ddb7dda4c9dfde63e718fe71087a4c961d2739d6f1d",
      "durationSeconds": 3.587458333333333
    },
    {
      "sceneId": "cups",
      "cueIndex": 1,
      "contentHash": "f53c1985179b48af649a90019e034892255724dbbfaf858e4002f37b2827adfd",
      "model": "cosyvoice-v3-flash",
      "voice": "longsanshu_v3",
      "rate": 0.82,
      "format": "wav",
      "sampleRate": 24000,
      "text": "引以为流觞曲水，列坐其次。",
      "path": "out/extended/speech/cue-f53c1985179b48af649a90019e034892255724dbbfaf858e4002f37b2827adfd.wav",
      "sha256": "af95e8bb0ce5f9dae73bf6c4a2f3ce1ad9897beb6b2f5601459569cd8de24db4",
      "durationSeconds": 4.663666666666667
    },
    {
      "sceneId": "poems",
      "cueIndex": 1,
      "contentHash": "c319783d0389242431f7a97f0fd7594d5261896ba402de1a505823f73dc4e743",
      "model": "cosyvoice-v3-flash",
      "voice": "longsanshu_v3",
      "rate": 0.82,
      "format": "wav",
      "sampleRate": 24000,
      "text": "虽无丝竹管弦之盛，一觞一咏，亦足以畅叙幽情。",
      "path": "out/extended/speech/cue-c319783d0389242431f7a97f0fd7594d5261896ba402de1a505823f73dc4e743.wav",
      "sha256": "a3f735c10e48b6776527d952cfe040e02893f14cae08943a57178cc55a24e5c1",
      "durationSeconds": 6.636791666666666
    },
    {
      "sceneId": "breeze",
      "cueIndex": 1,
      "contentHash": "cb1763681be6ecf3c3311e0ef129b305d7bb6f17c3da4eb0ab1657e8707a56d8",
      "model": "cosyvoice-v3-flash",
      "voice": "longsanshu_v3",
      "rate": 0.82,
      "format": "wav",
      "sampleRate": 24000,
      "text": "是日也，天朗气清，惠风和畅。",
      "path": "out/extended/speech/cue-cb1763681be6ecf3c3311e0ef129b305d7bb6f17c3da4eb0ab1657e8707a56d8.wav",
      "sha256": "f216d928949d3360ef57c218028bd9af035e7890dd666d7c226460bc23ade17d",
      "durationSeconds": 3.8565
    },
    {
      "sceneId": "joy",
      "cueIndex": 1,
      "contentHash": "5e6cce0ba02fa480cc0bb46e6c21e9976110148e001e2ab589bdd2347a6b507f",
      "model": "cosyvoice-v3-flash",
      "voice": "longsanshu_v3",
      "rate": 0.82,
      "format": "wav",
      "sampleRate": 24000,
      "text": "仰观宇宙之大，俯察品类之盛，所以游目骋怀，",
      "path": "out/extended/speech/cue-5e6cce0ba02fa480cc0bb46e6c21e9976110148e001e2ab589bdd2347a6b507f.wav",
      "sha256": "b501d37ce092ebfb6ba029b5ff9ce1fbfd58834256a37bf58530c75174f02d28",
      "durationSeconds": 7.802708333333333
    },
    {
      "sceneId": "joy",
      "cueIndex": 2,
      "contentHash": "4ee253534ea6b6e8273fb32ce96928631316aca604f20da7fff8be54b46580eb",
      "model": "cosyvoice-v3-flash",
      "voice": "longsanshu_v3",
      "rate": 0.82,
      "format": "wav",
      "sampleRate": 24000,
      "text": "足以极视听之娱，信可乐也。",
      "path": "out/extended/speech/cue-4ee253534ea6b6e8273fb32ce96928631316aca604f20da7fff8be54b46580eb.wav",
      "sha256": "d62b20fa67d51a0eb034d085b4ba5a6b28f92d0f624a8641dd84be2934c694bc",
      "durationSeconds": 4.663666666666667
    },
    {
      "sceneId": "life",
      "cueIndex": 1,
      "contentHash": "86e32ff444ec65306bcec000a6d7c9a0f9e03da3d084d5759cb3285d4e6d7ae6",
      "model": "cosyvoice-v3-flash",
      "voice": "longsanshu_v3",
      "rate": 0.82,
      "format": "wav",
      "sampleRate": 24000,
      "text": "夫人之相与，俯仰一世，或取诸怀抱，",
      "path": "out/extended/speech/cue-86e32ff444ec65306bcec000a6d7c9a0f9e03da3d084d5759cb3285d4e6d7ae6.wav",
      "sha256": "7de2c75a60cc1c407078d1c26edb194ad99e85010764703e729794bf08c95c02",
      "durationSeconds": 5.5605416666666665
    },
    {
      "sceneId": "life",
      "cueIndex": 2,
      "contentHash": "f2db27fb7b95dd114873181a729f2682af152b0bef8cec701884d748630559f1",
      "model": "cosyvoice-v3-flash",
      "voice": "longsanshu_v3",
      "rate": 0.82,
      "format": "wav",
      "sampleRate": 24000,
      "text": "悟言一室之内；或因寄所托，放浪形骸之外。",
      "path": "out/extended/speech/cue-f2db27fb7b95dd114873181a729f2682af152b0bef8cec701884d748630559f1.wav",
      "sha256": "b08139f3c056c3cb4c2a330e6b5cb45e683eb186fb35e358d2fe4fcceca3ee86",
      "durationSeconds": 5.6502083333333335
    },
    {
      "sceneId": "contentment",
      "cueIndex": 1,
      "contentHash": "52da61367670d521bba4a833c2d690fed1245bb297fabc135174ef2d048afa39",
      "model": "cosyvoice-v3-flash",
      "voice": "longsanshu_v3",
      "rate": 0.82,
      "format": "wav",
      "sampleRate": 24000,
      "text": "虽趣舍万殊，静躁不同，当其欣于所遇，",
      "path": "out/extended/speech/cue-52da61367670d521bba4a833c2d690fed1245bb297fabc135174ef2d048afa39.wav",
      "sha256": "04a8c24d6e98a82018916a7a9f28ec9cfafbaef8dadff86669a3a6f3140f3053",
      "durationSeconds": 5.919291666666667
    },
    {
      "sceneId": "contentment",
      "cueIndex": 2,
      "contentHash": "607be72c2f974ada99fa25fdcdc64f13301a9fa3bddec72cd64d1db141159ce1",
      "model": "cosyvoice-v3-flash",
      "voice": "longsanshu_v3",
      "rate": 0.82,
      "format": "wav",
      "sampleRate": 24000,
      "text": "暂得于己，快然自足，不知老之将至。",
      "path": "out/extended/speech/cue-607be72c2f974ada99fa25fdcdc64f13301a9fa3bddec72cd64d1db141159ce1.wav",
      "sha256": "dec57346f9b59d5f0034cc3e262a115b94be173d6d59239da7382f2d8b351f42",
      "durationSeconds": 5.381166666666667
    },
    {
      "sceneId": "change",
      "cueIndex": 1,
      "contentHash": "7eb22e70f30ee763e55f28e5ae165da39864e268e46a94d0d44816df3cda4552",
      "model": "cosyvoice-v3-flash",
      "voice": "longsanshu_v3",
      "rate": 0.82,
      "format": "wav",
      "sampleRate": 24000,
      "text": "及其所之既倦，情随事迁，感慨系之矣。",
      "path": "out/extended/speech/cue-7eb22e70f30ee763e55f28e5ae165da39864e268e46a94d0d44816df3cda4552.wav",
      "sha256": "11a01e5bb2394d02eb8073c4644837b437e8ac42acd988283ff9e96b1f3703f9",
      "durationSeconds": 6.278041666666667
    },
    {
      "sceneId": "traces",
      "cueIndex": 1,
      "contentHash": "3be48ce191e42431031eb1b6647980db5f36f62ad6434fd693bbee1f1d671ad6",
      "model": "cosyvoice-v3-flash",
      "voice": "longsanshu_v3",
      "rate": 0.82,
      "format": "wav",
      "sampleRate": 24000,
      "text": "向之所欣，俯仰之间，已为陈迹，",
      "path": "out/extended/speech/cue-3be48ce191e42431031eb1b6647980db5f36f62ad6434fd693bbee1f1d671ad6.wav",
      "sha256": "e84f9b8abc0aab31a7b5f581a4c51ce2e3d95719b6fe7c4daaab2e0a2f18c87a",
      "durationSeconds": 5.201791666666667
    },
    {
      "sceneId": "traces",
      "cueIndex": 2,
      "contentHash": "67b7ca461daaa072a516bc9f2965f28af641aee74008d603a74005d84d86a52d",
      "model": "cosyvoice-v3-flash",
      "voice": "longsanshu_v3",
      "rate": 0.82,
      "format": "wav",
      "sampleRate": 24000,
      "text": "犹不能不以之兴怀。",
      "path": "out/extended/speech/cue-67b7ca461daaa072a516bc9f2965f28af641aee74008d603a74005d84d86a52d.wav",
      "sha256": "218e340a1262266a95f48d3beb977a84bd0bfd8c21f8d9c62f0339c0848487d7",
      "durationSeconds": 2.6009166666666665
    },
    {
      "sceneId": "mortality",
      "cueIndex": 1,
      "contentHash": "8ed3f96f05194f51f7694d371db2df939dc72bff68d69d4e191527166bde6adc",
      "model": "cosyvoice-v3-flash",
      "voice": "longsanshu_v3",
      "rate": 0.78,
      "format": "wav",
      "sampleRate": 24000,
      "text": "况修短随化，终期于尽。古人云：“死生亦大矣。”",
      "path": "out/extended/speech/cue-8ed3f96f05194f51f7694d371db2df939dc72bff68d69d4e191527166bde6adc.wav",
      "sha256": "e209569c91129341906572ed4577004f4dacc412e8ba568d09af3c612ab932e3",
      "durationSeconds": 6.5437916666666665
    },
    {
      "sceneId": "mortality",
      "cueIndex": 2,
      "contentHash": "e3e0987600c589014ecf6f3fb7b97cfec03102c70003b455de0c63f5ccee4f08",
      "model": "cosyvoice-v3-flash",
      "voice": "longsanshu_v3",
      "rate": 0.78,
      "format": "wav",
      "sampleRate": 24000,
      "text": "岂不痛哉！",
      "path": "out/extended/speech/cue-e3e0987600c589014ecf6f3fb7b97cfec03102c70003b455de0c63f5ccee4f08.wav",
      "sha256": "e2180f552778bc66bbd7d6720f15d7e8c63c5539b1b599466ada1e221d6411d0",
      "durationSeconds": 1.7511666666666668
    },
    {
      "sceneId": "reading",
      "cueIndex": 1,
      "contentHash": "ccda476b7e77f1c0d2a2c0a92fbb236971e94c723fd9153bf13dd9588f9afd6f",
      "model": "cosyvoice-v3-flash",
      "voice": "longsanshu_v3",
      "rate": 0.78,
      "format": "wav",
      "sampleRate": 24000,
      "text": "每览昔人兴感之由，若合一契，未尝不临文嗟悼，",
      "path": "out/extended/speech/cue-ccda476b7e77f1c0d2a2c0a92fbb236971e94c723fd9153bf13dd9588f9afd6f.wav",
      "sha256": "573f0607ed91386632845f9859287b019a47fbd30e91458f8fc15963a104d946",
      "durationSeconds": 8.20275
    },
    {
      "sceneId": "reading",
      "cueIndex": 2,
      "contentHash": "c2ad1e51bbb4c47a9de5ed5fd4dd0f03624913c1d49398bcfd0a06baeddd98cd",
      "model": "cosyvoice-v3-flash",
      "voice": "longsanshu_v3",
      "rate": 0.78,
      "format": "wav",
      "sampleRate": 24000,
      "text": "不能喻之于怀。",
      "path": "out/extended/speech/cue-c2ad1e51bbb4c47a9de5ed5fd4dd0f03624913c1d49398bcfd0a06baeddd98cd.wav",
      "sha256": "e11ecf0071af5718b0fc33303ffa5e526aaf8bbb2ba2af63461002cca880523c",
      "durationSeconds": 1.7511666666666668
    },
    {
      "sceneId": "judgment",
      "cueIndex": 1,
      "contentHash": "6fa76ce37382853cf71cf9c3ff70ddd86d1c411519b44f235c5b93fb1d841286",
      "model": "cosyvoice-v3-flash",
      "voice": "longsanshu_v3",
      "rate": 0.78,
      "format": "wav",
      "sampleRate": 24000,
      "text": "固知一死生为虚诞，齐彭殇为妄作。",
      "path": "out/extended/speech/cue-6fa76ce37382853cf71cf9c3ff70ddd86d1c411519b44f235c5b93fb1d841286.wav",
      "sha256": "6655966a409e54cb5194dbf5355bbf8b98a107e1ef2bb8cca68ab6853bc31936",
      "durationSeconds": 5.069125
    },
    {
      "sceneId": "time",
      "cueIndex": 1,
      "contentHash": "7d22cb354b1024f2cb16ae7368680717c62845efb118ca99bab4395c4e2ac36f",
      "model": "cosyvoice-v3-flash",
      "voice": "longsanshu_v3",
      "rate": 0.78,
      "format": "wav",
      "sampleRate": 24000,
      "text": "后之视今，亦犹今之视昔，悲夫！",
      "path": "out/extended/speech/cue-7d22cb354b1024f2cb16ae7368680717c62845efb118ca99bab4395c4e2ac36f.wav",
      "sha256": "e501c8f974e4ec4cc7e121ab0bdac1106f13ddc666e388e78bcee4331d08df5b",
      "durationSeconds": 5.345625
    },
    {
      "sceneId": "record",
      "cueIndex": 1,
      "contentHash": "303fec880a8b2a560805ad56a9e336b743d509b12572c9706bbfc81bd1da8e61",
      "model": "cosyvoice-v3-flash",
      "voice": "longsanshu_v3",
      "rate": 0.78,
      "format": "wav",
      "sampleRate": 24000,
      "text": "故列叙时人，录其所述，虽世殊事异，所以兴怀，",
      "path": "out/extended/speech/cue-303fec880a8b2a560805ad56a9e336b743d509b12572c9706bbfc81bd1da8e61.wav",
      "sha256": "7fb696ee8dbf8ca580705030000063f60174fb34f04fbd2cc052cab7cf605d06",
      "durationSeconds": 8.110583333333333
    },
    {
      "sceneId": "record",
      "cueIndex": 2,
      "contentHash": "6dd33e2eb4c5d29ff35e5182ab7cd1df15ade049e957e715c3952cb6999531e4",
      "model": "cosyvoice-v3-flash",
      "voice": "longsanshu_v3",
      "rate": 0.78,
      "format": "wav",
      "sampleRate": 24000,
      "text": "其致一也。",
      "path": "out/extended/speech/cue-6dd33e2eb4c5d29ff35e5182ab7cd1df15ade049e957e715c3952cb6999531e4.wav",
      "sha256": "0e5c79a23b8f11cf85ef5e4702bd837e199dee50f4d76e81b412f264a4df0e80",
      "durationSeconds": 2.212
    },
    {
      "sceneId": "future",
      "cueIndex": 1,
      "contentHash": "a3dfd11f85be4c0fe4f5e1a89b9f1b5198895ae24acfb1b704087cebf62f71aa",
      "model": "cosyvoice-v3-flash",
      "voice": "longsanshu_v3",
      "rate": 0.78,
      "format": "wav",
      "sampleRate": 24000,
      "text": "后之览者，亦将有感于斯文。",
      "path": "out/extended/speech/cue-a3dfd11f85be4c0fe4f5e1a89b9f1b5198895ae24acfb1b704087cebf62f71aa.wav",
      "sha256": "83eb38b13a670ff92851513276b497796f4d7deac143dfdfebb69ff9c34b392d",
      "durationSeconds": 4.331791666666667
    }
  ]
}
