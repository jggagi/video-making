  "captions": [
    {
      "segmentId": "S01",
      "startFrame": 47,
      "endFrame": 161,
      "text": "他们说好，要一起白头",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S01",
      "startFrame": 161,
      "endFrame": 218,
      "text": "假如有一天",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S01",
      "startFrame": 218,
      "endFrame": 344,
      "text": "连衰老，也能被逆转呢？",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S02",
      "startFrame": 611,
      "endFrame": 726,
      "text": "这是一场科幻想象",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S02",
      "startFrame": 726,
      "endFrame": 898,
      "text": "人体大约三十七万亿颗细胞",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S02",
      "startFrame": 898,
      "endFrame": 1013,
      "text": "像一座座瓷的山谷",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S02",
      "startFrame": 1013,
      "endFrame": 1142,
      "text": "承受时间留下的改变",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S03",
      "startFrame": 1331,
      "endFrame": 1412,
      "text": "让生命回头",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S03",
      "startFrame": 1412,
      "endFrame": 1542,
      "text": "并不只是擦去皱纹",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S03",
      "startFrame": 1542,
      "endFrame": 1688,
      "text": "修复太少，衰老继续",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S03",
      "startFrame": 1688,
      "endFrame": 1753,
      "text": "改写太深",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S03",
      "startFrame": 1753,
      "endFrame": 1948,
      "text": "细胞又可能失去原本的身份",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S04",
      "startFrame": 2111,
      "endFrame": 2222,
      "text": "于是，在这个想象里",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S04",
      "startFrame": 2222,
      "endFrame": 2346,
      "text": "超级智能沿着无数岔路",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S04",
      "startFrame": 2346,
      "endFrame": 2444,
      "text": "寻找那条既能修复",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S04",
      "startFrame": 2444,
      "endFrame": 2568,
      "text": "又不让生命失控的窄路",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S05",
      "startFrame": 2831,
      "endFrame": 2977,
      "text": "第一粒碎屑，停住了",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S05",
      "startFrame": 2977,
      "endFrame": 3026,
      "text": "下一刻",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S05",
      "startFrame": 3026,
      "endFrame": 3156,
      "text": "整场瓷雨逆流而上",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S05",
      "startFrame": 3156,
      "endFrame": 3222,
      "text": "金色的河",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S05",
      "startFrame": 3222,
      "endFrame": 3368,
      "text": "重新接起每一道裂口",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S06",
      "startFrame": 3551,
      "endFrame": 3691,
      "text": "原来，那浩瀚的山谷",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S06",
      "startFrame": 3691,
      "endFrame": 3831,
      "text": "只是掌心的一道纹路",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S06",
      "startFrame": 3831,
      "endFrame": 3971,
      "text": "那双握了几十年的手",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S06",
      "startFrame": 3971,
      "endFrame": 4095,
      "text": "再一次，变得年轻",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S07",
      "startFrame": 4211,
      "endFrame": 4264,
      "text": "春去秋来",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S07",
      "startFrame": 4264,
      "endFrame": 4343,
      "text": "他们依然相爱",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S07",
      "startFrame": 4343,
      "endFrame": 4422,
      "text": "却再也等不到",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S07",
      "startFrame": 4422,
      "endFrame": 4527,
      "text": "彼此白头的那一天",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S08",
      "startFrame": 4907,
      "endFrame": 4991,
      "text": "死亡不再是终点",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S08",
      "startFrame": 4991,
      "endFrame": 5064,
      "text": "只是那句人类",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S08",
      "startFrame": 5064,
      "endFrame": 5184,
      "text": "说了几千年的白头偕老",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S08",
      "startFrame": 5184,
      "endFrame": 5232,
      "text": "从此成了",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    },
    {
      "segmentId": "S08",
      "startFrame": 5232,
      "endFrame": 5365,
      "text": "再也无人能懂的远古词汇",
      "alignment": "estimated_character_weighted_within_measured_pcm_span"
    }
  ],
