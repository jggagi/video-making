      "endFrame": 1082,
      "start": "00:00:14,989",
      "end": "00:00:18,029",
      "text": "就要把一点点热，交给周围的世界。",
      "displayOnly": false,
      "phraseSource": "chunks",
      "alignment": "estimated phrase timing from measured active PCM samples; not word aligned"
